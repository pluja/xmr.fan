# Copy to .env (never commit it). Everything is optional for the website itself;
# these are for the weekly Times pipeline and maintenance scripts.

# Writing (any OpenAI-compatible API)
OPENAI_ENDPOINT=https://api.nano-gpt.com/v1
MODEL=anthropic/claude-sonnet-5.5
API_KEY=

# nano-gpt: X and Reddit search, headline art, podcast voices
NANO_GPT_API_KEY=

# Optional sources and tuning
GITHUB_TOKEN=
COINGECKO_API_KEY=
MONERO_NODES=
GAZETTE_X_ACCOUNTS=
ART_MODEL=
ART_RESOLUTION=
ART_ASPECT=
PODCAST_HOSTS=
# Voices for one language, e.g. PODCAST_HOSTS_ES="Chris:Chris,Jessica:Jessica"
PODCAST_HOSTS_ES=
PODCAST_MINUTES=
PODCAST_TTS_MODEL=

# Automation (ops/job.sh)
# ntfy topic for job reports, e.g. https://ntfy.sh/xmrfan-<something-hard-to-guess>
NOTIFY_URL=
NOTIFY_TOKEN=
# Hours between "draft ready" and the issue going live (0 publishes at once)
GAZETTE_REVIEW_HOURS=12
# Podcast languages, comma separated (each costs text-to-speech)
PODCAST_LANGS=en,es
# Host directory for podcast audio (it gets a podcast/ folder), kept out of git and the build;
# the site serves it at /podcast/. Defaults to ./public for development.
MEDIA_DIR=

# Docker: the host user and group (id -u / id -g) the containers run as, so files they write stay yours
RUN_UID=1000
RUN_GID=1000

# Server
SPONSOR_REQUESTS_DIR=sponsor-requests
# Include draft issues in a production build (staging previews only)
GAZETTE_SHOW_DRAFTS=
