# One run of ops/job.sh. Install with the timers: see "Automation" in README.md.
[Unit]
Description=xmr.fan job: %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The user that owns the checkout and may use Docker.
User=xmrfan
WorkingDirectory=/opt/stacks/xmrfan
ExecStart=/opt/stacks/xmrfan/ops/job.sh %i
TimeoutStartSec=2h
