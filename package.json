{
  "name": "xmr-fan",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test --experimental-strip-types --no-warnings src/lib/*.test.ts src/lib/server/*.test.ts scripts/gazette/*.test.ts",
    "gazette": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/gazette/generate.ts",
    "gazette:publish": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/gazette/publish.ts",
    "gazette:podcast": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/gazette/podcast.ts",
    "gazette:translate": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/gazette/translate.ts",
    "sponsor:list": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/sponsor.ts list",
    "sponsor:approve": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/sponsor.ts approve",
    "heights": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/heights.ts",
    "brand": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/brand-images.ts",
    "donations:check": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings scripts/donations.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "openpgp": "^6.3.2",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "fast-xml-parser": "^5.11.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
