---
/* One issue, published or not, behind the preview key: /news/preview/<week>
   Rendered on request, so the draft only has to be in the deployed build. */
import { getEntry } from "astro:content";
import EditionPage from "../../../../components/gazette/EditionPage.astro";
import PreviewGate from "../../../../components/gazette/PreviewGate.astro";
import { langFromParams } from "../../../../i18n/ui";
import { previewAccess } from "../../../../lib/gazette-preview";

export const prerender = false;

const lang = langFromParams(Astro.params);
const access = await previewAccess(Astro);
if (access === null) return new Response("Not found", { status: 404 });
if (access instanceof Response) return access;
if (access !== "open") Astro.response.status = 401;
const edition = access === "open" && Astro.params.week ? await getEntry("gazette", Astro.params.week) : undefined;
if (access === "open" && !edition) return new Response("Not found", { status: 404 });
---
{edition ? <EditionPage lang={lang} editionId={edition.id} withDrafts /> : <PreviewGate lang={lang} state={access as "locked" | "wrong"} />}
