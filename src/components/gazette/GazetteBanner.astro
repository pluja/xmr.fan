---
import GazetteWordmark from "../GazetteWordmark.astro";
import PixelIcon from "../PixelIcon.astro";
import { localePath, useTranslations, type Locale } from "../../i18n/ui";
import { editionPath, formatDate, localize, visibleEditions } from "../../lib/gazette";

interface Props { lang: Locale; class?: string }
const { lang, class: cls } = Astro.props;
const t = useTranslations(lang);
const editions = await visibleEditions();
const latest = editions[0];
const d = latest && localize(latest.data, lang);
---
{latest && d && (
  <a
    href={localePath(lang, editionPath(latest, editions))}
    class:list={["group flex items-center gap-3 border-2 border-orange bg-ink py-1.5 pl-1.5 pr-3 text-cream no-underline hover:bg-graphite sm:gap-4 sm:pr-4", cls]}
  >
    {d.art?.file && (
      <img src={d.art.file} alt="" width="1536" height="864" loading="eager" decoding="async" class="block aspect-video w-16 shrink-0 object-cover [image-rendering:pixelated] sm:w-20" />
    )}
    <span class="flex min-w-0 flex-1 flex-col gap-1 lg:flex-row lg:items-center lg:gap-6">
      <span class="grid shrink-0 gap-1">
        <span class="flex items-center gap-2.5">
          <span class="banner-stamp border border-orange px-1 font-pixel text-[11px] uppercase leading-4 text-orange">{t("g_new")}</span>
          <span class="w-32 text-orange sm:w-40"><GazetteWordmark label={t("g_title")} /></span>
        </span>
        <span class="hidden font-pixel text-xs text-ash sm:block">{t("g_no", { n: d.no })} · {t("g_week", { d: formatDate(d.week, lang) })}</span>
      </span>
      <span class="line-clamp-2 min-w-0 text-[15px] font-semibold leading-snug sm:line-clamp-1">{d.lead.h}</span>
    </span>
    {d.podcast && (
      <span class="hidden shrink-0 items-center gap-2 whitespace-nowrap font-pixel text-xs text-ash sm:inline-flex">
        <PixelIcon name="sound" size={14} class="shrink-0" />{t("g_listen_min", { min: Math.round(d.podcast.duration / 60) })}
      </span>
    )}
    <span class="shrink-0 font-pixel text-xl text-orange transition-transform group-hover:translate-x-1">
      <span class="sr-only">{t("g_read_week")}</span><span aria-hidden="true">→</span>
    </span>
  </a>
)}

<style>
  @media (prefers-reduced-motion: no-preference) {
    /* Three quick blinks, then still for about ten seconds. */
    .banner-stamp { animation: stamp-blink 12s steps(1) infinite; }
    @keyframes stamp-blink {
      0%, 4%, 8% { background: var(--color-orange); color: var(--color-ink); }
      2%, 6%, 10%, 100% { background: transparent; color: var(--color-orange); }
    }
  }
</style>
