---
import Base from "../../layouts/Base.astro";
import Container from "../Container.astro";
import PixelIcon from "../PixelIcon.astro";
import type { Locale } from "../../i18n/ui";

interface Props { lang: Locale; path: string; state: "locked" | "wrong" | "empty" }
const { lang, path, state } = Astro.props;
const COPY = {
  locked: ["Blocked.", "Unpublished issues need the preview key."],
  wrong: ["Wrong key.", "Try again."],
  empty: ["Nothing to review.", "There is no unpublished issue right now."],
} as const;
const [title, line] = COPY[state];
---
<Base lang={lang} path={path} title={title} noindex active="gazette">
  <Container as="section" class="py-20">
    <h1 class="mb-3 flex items-center gap-3 font-pixel text-[clamp(28px,4.4vw,48px)]">
      <PixelIcon name={state === "empty" ? "lens" : "shield"} size={28} />{title}
    </h1>
    <p class="mb-8 max-w-[50ch]">{line}</p>
    {state !== "empty" && (
      <form method="post" class="flex max-w-md flex-wrap gap-3">
        <input class="field min-w-0 flex-1 font-mono" type="password" name="key" required autofocus autocomplete="current-password" aria-label="Preview key" placeholder="Preview key" />
        <button class="btn" type="submit">Open</button>
      </form>
    )}
  </Container>
</Base>
