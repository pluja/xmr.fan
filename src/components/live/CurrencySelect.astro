---
/* Every picker on the page stays in sync and the choice is remembered. Read it with currency.ts. */
import { useTranslations, type Locale } from "../../i18n/ui";
import { CURRENCIES } from "../../lib/currency";

interface Props { lang: Locale; class?: string }
const { lang, class: cls } = Astro.props;
const t = useTranslations(lang);
---
<label class:list={["inline-flex items-center gap-2 text-sm font-semibold", cls]}>
  <span>{t("currency")}</span>
  <select data-currency class="field w-auto py-1.5 font-mono text-sm">
    {CURRENCIES.map((c) => <option value={c}>{c.toUpperCase()}</option>)}
  </select>
</label>
