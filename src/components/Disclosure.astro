---
interface Props { title: string; open?: boolean; class?: string; [attr: string]: unknown }
const { title, open, class: cls, ...attrs } = Astro.props;
---
<details class:list={["group border-2 border-ink bg-paper", cls]} open={open} {...attrs}>
  <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-3 font-pixel text-[17px] [&::-webkit-details-marker]:hidden">
    <span class="inline-block w-3 transition-transform group-open:rotate-90" aria-hidden="true">▶</span>
    <span>{title}</span>
  </summary>
  <div class="grid gap-3 border-t-2 border-ink px-4 pb-4 pt-3"><slot /></div>
</details>
