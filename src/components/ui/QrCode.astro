---
/* A pixel QR code that a script fills in with renderQr() from qr.ts. With `brackets`, orange scan
   corners frame it and a label sits on the bottom edge. The slot is the placeholder shown while empty. */
interface Props { brackets?: string; class?: string; [attr: string]: unknown }
const { brackets, class: cls, ...attrs } = Astro.props;
const corner = "absolute size-6 border-orange";
---
<div class:list={["relative", brackets && "p-3.5", cls]} {...attrs}>
  {brackets && (
    <>
      <span class:list={[corner, "top-0 left-0 border-t-4 border-l-4"]}></span>
      <span class:list={[corner, "top-0 right-0 border-t-4 border-r-4"]}></span>
      <span class:list={[corner, "bottom-0 left-0 border-b-4 border-l-4"]}></span>
      <span class:list={[corner, "right-0 bottom-0 border-r-4 border-b-4"]}></span>
      <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 bg-paper px-2 font-pixel text-[10px] tracking-[0.2em] text-flame uppercase">{brackets}</span>
    </>
  )}
  <div data-qr class="grid aspect-square place-items-center [&.reveal_svg]:motion-safe:animate-qr-print"><slot /></div>
</div>
