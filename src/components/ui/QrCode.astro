---
import { cx } from "./styles";
/* A pixel QR code that a script fills in with qrBox() from qr.ts. With `brackets`, scan corners
   frame it and the text is their label. The slot is the placeholder shown while empty. */
import Corners from "./Corners.astro";

interface Props { brackets?: string; class?: string; [attr: string]: unknown }
const { brackets, class: cls, ...attrs } = Astro.props;
---
<div class={cx("relative", brackets && "p-3.5", cls)} {...attrs}>
  {brackets && <Corners label={brackets} />}
  <div data-qr class="grid aspect-square place-items-center [&.reveal_svg]:motion-safe:animate-qr-print"><slot /></div>
</div>
