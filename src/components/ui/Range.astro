---
/* A pixel slider (volume and the like): an orange block thumb on a dark track. */
import { cx } from "./styles";

interface Props { name: string; label: string; min?: number; max?: number; step?: number; value?: number; class?: string }
const { name, label, min = 0, max = 1, step = 0.05, value = 0.8, class: cls } = Astro.props;
---
<input
  type="range" name={name} min={min} max={max} step={step} value={value} aria-label={label}
  class={cx(
    "h-11 w-28 cursor-pointer appearance-none bg-transparent",
    "[&::-webkit-slider-runnable-track]:h-2 [&::-webkit-slider-runnable-track]:bg-graphite [&::-moz-range-track]:h-2 [&::-moz-range-track]:bg-graphite",
    "[&::-webkit-slider-thumb]:-mt-1.5 [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:bg-orange",
    "[&::-moz-range-thumb]:h-5 [&::-moz-range-thumb]:w-3 [&::-moz-range-thumb]:rounded-none [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-orange",
    cls,
  )}
/>
