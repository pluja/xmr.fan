---
import Container from "./Container.astro";
import PixelIcon from "./PixelIcon.astro";
import RelatedTools from "./ui/RelatedTools.astro";
import TitleBar from "./TitleBar.astro";
import { localePath, useTranslations, type Locale } from "../i18n/ui";
import { titleKey, descKey, nextTool, toolPath, type Tool } from "../lib/tools";

interface Props {
  lang: Locale;
  tool: Tool;
  /** A full-width dark panel with the description in the title bar. */
  dark?: boolean;
}
const { lang, tool, dark = false } = Astro.props;
const t = useTranslations(lang);
const next = nextTool(tool);
---
<section class="on-ink flex-1 bg-ink pb-20 pt-4 text-cream sm:pt-5" data-tool-frame>
  <Container>
    <nav class="mb-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <a id="back" href={localePath(lang, "/")} class="group inline-flex items-center gap-2.5 py-1.5 font-pixel text-orange no-underline">
        <PixelIcon name="back" size={18} />
        <span class="group-hover:underline">{t("back")}</span>
      </a>
      <a href={localePath(lang, toolPath(next))} class="group hidden items-center gap-2 font-pixel text-sm text-peach no-underline hover:text-orange sm:inline-flex">
        <span class="group-hover:underline">{t("next_tool", { tool: t(titleKey(next)) })}</span>
        <svg viewBox="0 0 3 5" width="6" height="10" aria-hidden="true" shape-rendering="crispEdges"><path d="M0 0h1v1H0zM1 1h1v1H1zM2 2h1v1H2zM1 3h1v1H1zM0 4h1v1H0z" fill="currentColor" /></svg>
      </a>
    </nav>
    {dark ? (
      <article class="bg-ink-2 shadow-[8px_8px_0_var(--color-shade)]">
        <header class="flex flex-wrap items-center gap-x-8 gap-y-1 bg-orange px-5 py-3.5 text-ink sm:px-7">
          <div class="flex items-center gap-3.5">
            <PixelIcon name={tool.icon} size={26} class="shrink-0" />
            <h1 class="font-pixel text-xl sm:text-2xl">{t(titleKey(tool))}</h1>
          </div>
          <p class="text-[15px] text-ink/80">{t(descKey(tool))}</p>
          <kbd class="ml-auto hidden border-2 border-ink px-2 font-pixel text-xs sm:inline">Esc</kbd>
        </header>
        <div class="px-5 pb-7 pt-5 sm:px-7">
          <slot />
        </div>
      </article>
    ) : (
      <article class="max-w-[920px] border-2 border-orange">
        <TitleBar icon={tool.icon} level={1} kbd="Esc">{t(titleKey(tool))}</TitleBar>
        <div class="bg-cream px-5 pb-6 pt-4 text-ink sm:px-6">
          <p class="mb-5 text-[15px]">{t(descKey(tool))}</p>
          <slot />
        </div>
      </article>
    )}
    <slot name="after" />
    <RelatedTools lang={lang} current={tool} />
  </Container>
</section>

<script>
  // Esc leaves a field first; a second Esc goes back to all tools.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const el = document.activeElement as HTMLElement | null;
    if (el && /^(INPUT|TEXTAREA)$/.test(el.tagName)) { el.blur(); return; }
    (document.getElementById("back") as HTMLAnchorElement).click();
  });
</script>
