---
import PixelIcon from "./PixelIcon.astro";
import { localePath, useTranslations, type Locale } from "../i18n/ui";
import { titleKey, descKey, toolPath, type Tool } from "../lib/tools";

interface Props { lang: Locale; tool: Tool }
const { lang, tool } = Astro.props;
const t = useTranslations(lang);
const title = t(titleKey(tool));
const desc = t(descKey(tool));
const Tag = tool.live ? "a" : "div";
---
<li data-search={`${title} ${desc}`.toLowerCase()} class="drop-shadow-[4px_4px_0_var(--color-shade)] has-[a:hover]:drop-shadow-[5px_5px_0_var(--color-ember)] has-[.hl]:drop-shadow-[5px_5px_0_var(--color-ember)]">
  <Tag
    href={tool.live ? localePath(lang, toolPath(tool)) : undefined}
    aria-disabled={tool.live ? undefined : "true"}
    class:list={["group pixel-corners relative grid h-full grid-cols-[40px_1fr_10px] items-center gap-3 bg-ink-2 p-3 text-cream no-underline inset-ring-2 inset-ring-graphite focus-visible:outline-none focus-visible:inset-ring-cream sm:grid-cols-[48px_1fr_10px] sm:gap-3.5 sm:p-3.5", tool.live && "hover:bg-[#3d3843] hover:inset-ring-orange [&.hl]:bg-[#3d3843] [&.hl]:inset-ring-orange", !tool.live && "opacity-70"]}
  >
    <span class="pixel-corners grid size-10 place-items-center bg-[#3d2c25] text-orange inset-ring-2 inset-ring-[#5e3b27] group-hover:bg-[#4a2e1d] group-hover:inset-ring-orange group-[.hl]:bg-[#4a2e1d] group-[.hl]:inset-ring-orange sm:size-12"><PixelIcon name={tool.icon} class="size-6 sm:size-7" /></span>
    <span class="grid min-w-0 gap-1">
      <b class="flex flex-wrap items-center gap-x-2.5 font-pixel text-[15px] font-normal leading-tight">
        {title}
        {tool.id === "live" && (
          <span class="flex items-center gap-1 bg-[#1f3a2a] px-1.5 py-px font-pixel text-[10px] uppercase text-[#4ade80]"><i class="size-1.5 bg-current"></i>{t("badge_live")}</span>
        )}
        {!tool.live && <em class="border border-ash px-1.5 font-pixel text-xs not-italic text-ash">{t("soon")}</em>}
      </b>
      <span class="text-sm leading-snug text-ash group-hover:text-peach group-[.hl]:text-peach">{desc}</span>
    </span>
    <svg viewBox="0 0 3 5" width="6" height="10" class="text-line group-hover:text-orange group-[.hl]:text-orange" aria-hidden="true" shape-rendering="crispEdges"><path d="M0 0h1v1H0zM1 1h1v1H1zM2 2h1v1H2zM1 3h1v1H1zM0 4h1v1H0z" fill="currentColor" /></svg>
  </Tag>
</li>
