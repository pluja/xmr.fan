---
import PixelIcon from "../PixelIcon.astro";
import AddressInput from "../ui/AddressInput.astro";
import Range from "../ui/Range.astro";
import TrustNote from "../ui/TrustNote.astro";
import { button, cx, link, message } from "../ui/styles";
import donations from "../../data/donations.json";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "bt_play", "bt_stop", "bt_info", "bt_error", "bt_recording", "bt_video",
  "bt_scale_minor", "bt_scale_major", "bt_scale_dorian", "bt_scale_phrygian", "bt_scale_lydian", "copied",
]);
const PRESETS = ["getmonero", "torproject", "grapheneos", "privacyguides", "p2pool", "wikileaks"]
  .map((id) => donations.find((d) => d.id === id))
  .filter((d): d is (typeof donations)[number] => !!d);
---
<div id="beat-tool" class="grid grid-cols-1 gap-6" data-strings={strings}>
  <section class="grid gap-2.5">
    <div class="flex items-baseline justify-between gap-4">
      <label for="bt-address" class="flex items-center gap-2.5 font-pixel text-sm tracking-[0.2em] text-cream uppercase"><span class="size-2 bg-orange"></span>{t("bt_address")}</label>
      <button type="button" data-example class={link}>{t("try_example")}</button>
    </div>
    <AddressInput id="bt-address" name="address" paste={t("pl_paste")} describedby="beat-message" />
    <p id="beat-message" class={message}></p>
    <div class="flex flex-wrap items-center gap-1.5 text-sm">
      <span class="text-ash">{t("bt_try")}:</span>
      {PRESETS.map((d) => <button type="button" data-preset={d.address} class="cursor-pointer border-2 border-graphite px-2.5 py-0.5 text-sm text-ash hover:border-orange hover:text-orange">{d.name}</button>)}
    </div>
  </section>

  <section data-stage class="grid gap-4 border-2 border-graphite bg-ink p-3 shadow-[8px_8px_0_var(--color-shade)] sm:p-4 [&:fullscreen]:flex [&:fullscreen]:flex-col [&:fullscreen]:items-center [&:fullscreen]:justify-center [&:fullscreen]:border-0 [&:fullscreen]:px-[3vw] [&:fullscreen]:py-[2vh] [&:fullscreen]:shadow-none [&:fullscreen>*]:w-[min(100%,calc(80vh*var(--ratio,1.78)))]" hidden>
    <canvas data-viz class="block w-full [image-rendering:pixelated]"></canvas>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <button type="button" data-play class={cx(button.primary, "min-w-32")}>
        <PixelIcon name="play" size={18} class="icon-play" /><PixelIcon name="pause" size={18} class="icon-pause hidden" /><span>{t("bt_play")}</span>
      </button>
      <p data-info class="font-pixel text-sm text-orange"></p>
      <div class="ml-auto flex items-center gap-3">
        <label class="flex items-center gap-2"><PixelIcon name="sound" size={16} class="text-orange" /><Range name="volume" label={t("bt_volume")} /></label>
        <button type="button" data-fullscreen class={cx(button.ghost, "px-3")} aria-label={t("bt_fullscreen")} title={t("bt_fullscreen")}><PixelIcon name="expand" size={16} /></button>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 border-t-2 border-graphite pt-4">
      <button type="button" data-video class={button.ghost}><PixelIcon name="download" size={16} class="text-orange" /><span>{t("bt_video")}</span></button>
      <button type="button" data-copy-from="#bt-link" class={button.ghost}><PixelIcon name="copy" size={16} class="text-orange" /><span>{t("bt_copy_link")}</span></button>
      <span id="bt-link" hidden></span>
      <span class="ml-auto hidden text-sm text-ash sm:inline">{t("bt_keys")}</span>
    </div>
  </section>

  <TrustNote icon="info" class="border-t-2 border-graphite pt-5">{t("bt_note")}</TrustNote>
</div>

<script>
  import { BeatPlayer } from "./beat-player";
  import { BeatVisuals } from "./beat-visuals";
  import { addressInput } from "../ui/address-input";
  import { bindCopyButtons } from "../ui/copy";
  import { readStrings } from "../../i18n/format";
  import { songFromAddress, STEPS, type Song } from "../../lib/beat";
  import { EXAMPLE_ADDRESS, parseAddress } from "../../lib/monero";

  const root = document.getElementById("beat-tool")!;
  const t = readStrings(root);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const address_ = addressInput($("[data-address-input]"), () => load());
  const input = address_.field;
  const stage = $("[data-stage]");
  const canvas = $<HTMLCanvasElement>("[data-viz]");
  const playBtn = $<HTMLButtonElement>("[data-play]");
  const visuals = new BeatVisuals(canvas);
  let player: BeatPlayer | undefined, song: Song | undefined, address = "";

  function ensurePlayer() {
    if (player) return player;
    player = new BeatPlayer();
    player.setVolume(Number($<HTMLInputElement>("input[name=volume]").value));
    player.onStep = (step) => visuals.hit(step);
    return player;
  }

  function setPlaying(on: boolean) {
    visuals.playing = on;
    playBtn.querySelector("span")!.textContent = t(on ? "bt_stop" : "bt_play");
    playBtn.querySelector(".icon-play")!.classList.toggle("hidden", on);
    playBtn.querySelector(".icon-pause")!.classList.toggle("hidden", !on);
  }

  function play() {
    if (!song) return;
    ensurePlayer().play(song);
    setPlaying(true);
  }

  function stop() {
    player?.stop();
    visuals.step = -1;
    setPlaying(false);
  }

  const toggle = () => (player?.playing ? stop() : play());

  function load() {
    const value = input.value.trim();
    const next = parseAddress(value).ok ? songFromAddress(value) : null;
    input.setAttribute("aria-invalid", String(!!value && !next));
    address_.show(!value ? "" : next ? "ok" : "error");
    $("#beat-message").textContent = value && !next ? t("bt_error") : "";
    stage.hidden = !next;
    if (!next) { stop(); visuals.stop(); return; }
    const changed = value !== address;
    song = next;
    address = value;
    visuals.setSong(song, value);
    visuals.start();
    $("[data-info]").textContent = t("bt_info", { bpm: song.bpm, key: song.key, scale: t(`bt_scale_${song.scale}`) });
    $("#bt-link").textContent = `${location.origin}${location.pathname}#${value}`;
    history.replaceState(null, "", `#${value}`);
    if (changed && player?.playing) player.play(song);
  }

  /** Records two loops of the stage, with sound, as a video people can post. */
  async function recordVideo() {
    const current = song;
    if (!current) return;
    const btn = $<HTMLButtonElement>("[data-video]"), label = btn.querySelector("span")!;
    const p = ensurePlayer();
    if (!p.playing) play();
    const type = ["video/mp4;codecs=avc1.42E01E,mp4a.40.2", "video/mp4", "video/webm;codecs=vp9,opus", "video/webm"].find((m) => MediaRecorder.isTypeSupported(m)) ?? "";
    const stream = new MediaStream([...canvas.captureStream(30).getVideoTracks(), ...p.stream.stream.getAudioTracks()]);
    const recorder = new MediaRecorder(stream, type ? { mimeType: type } : undefined);
    const chunks: Blob[] = [];
    recorder.ondataavailable = (e) => chunks.push(e.data);
    btn.disabled = true;
    label.textContent = t("bt_recording");
    recorder.start();
    await new Promise((r) => setTimeout(r, 2 * STEPS * (60 / current.bpm / 4) * 1000));
    recorder.stop();
    await new Promise((r) => (recorder.onstop = r));
    const ext = recorder.mimeType.includes("mp4") ? "mp4" : "webm";
    const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob(chunks, { type: recorder.mimeType })), download: `xmr-beat-${address.slice(0, 8)}.${ext}` });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 0);
    btn.disabled = false;
    label.textContent = t("bt_video");
  }

  playBtn.addEventListener("click", toggle);
  $("[data-video]").addEventListener("click", recordVideo);
  $("[data-fullscreen]").addEventListener("click", () => (document.fullscreenElement ? document.exitFullscreen() : stage.requestFullscreen()));
  $<HTMLInputElement>("input[name=volume]").addEventListener("input", (e) => player?.setVolume(Number((e.target as HTMLInputElement).value)));
  input.addEventListener("input", load);
  $("[data-example]").addEventListener("click", () => { address_.set(EXAMPLE_ADDRESS); load(); play(); });
  root.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) => b.addEventListener("click", () => { address_.set(b.dataset.preset!); load(); play(); }));
  bindCopyButtons(root, t("copied"));
  document.addEventListener("keydown", (e) => {
    if (e.key !== " " || stage.hidden || /^(INPUT|TEXTAREA|SELECT|BUTTON)$/.test((e.target as HTMLElement).tagName)) return;
    e.preventDefault();
    toggle();
  });

  address_.set(decodeURIComponent(location.hash.slice(1)));
  load();
</script>
