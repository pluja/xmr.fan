---
import CopyButton from "../CopyButton.astro";
import Field from "../Field.astro";
import PixelIcon from "../PixelIcon.astro";
import TryExample from "../TryExample.astro";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, ["bt_play", "bt_stop", "bt_info", "bt_error", "bt_recording", "bt_download", "bt_scale_minor", "bt_scale_major", "bt_scale_dorian", "bt_scale_phrygian", "bt_scale_lydian"]);
---
<div id="beat-tool" class="grid gap-5" data-strings={strings}>
  <div class="relative">
    <TryExample lang={lang} class="absolute right-0 top-0 !my-0 !py-0" />
    <Field label={t("bt_address")} messageId="beat-message">
      <textarea name="address" rows="2" spellcheck="false" autocomplete="off" autocapitalize="off" class="field min-h-14 resize-y font-mono text-[13px] [word-break:break-all]" aria-describedby="beat-message"></textarea>
    </Field>
  </div>

  <section data-stage class="grid gap-3 border-2 border-ink bg-ink p-4 text-cream shadow-[6px_6px_0_var(--color-graphite)]" hidden>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" data-play class="btn border-orange bg-orange text-ink"><PixelIcon name="play" size={18} class="icon-play" /><PixelIcon name="pause" size={18} class="icon-pause hidden" /><span>{t("bt_play")}</span></button>
      <p data-info class="font-pixel text-orange"></p>
    </div>
    <canvas data-viz width="720" height="400" class="block aspect-[9/5] w-full [image-rendering:pixelated]"></canvas>
    <p data-chars class="break-all font-mono text-[13px] leading-relaxed text-ash"></p>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-download class="btn btn-ghost border-cream text-cream"><PixelIcon name="download" size={16} /><span>{t("bt_download")}</span></button>
      <CopyButton lang={lang} text="" label={t("bt_copy_link")} class="btn-ghost border-cream text-cream" />
    </div>
  </section>

  <p class="max-w-[66ch] text-sm text-graphite">{t("bt_note")}</p>
</div>

<script>
  import { BeatPlayer } from "./beat-player";
  import { readStrings } from "../../i18n/format";
  import { songFromAddress, STEPS, type Song } from "../../lib/beat";
  import { EXAMPLE_ADDRESS, parseAddress } from "../../lib/monero";

  const root = document.getElementById("beat-tool")!;
  const t = readStrings(root);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const input = $<HTMLTextAreaElement>("textarea[name=address]");
  const canvas = $<HTMLCanvasElement>("[data-viz]");
  const ctx = canvas.getContext("2d")!;
  const playBtn = $<HTMLButtonElement>("[data-play]");
  const COLS = 12, ROWS = 6, GRID_H = 280;
  let player: BeatPlayer | undefined, song: Song | undefined, address = "", step = -1, flash = 0, charSpans: HTMLElement[] = [];

  /** Byte value -> a shade between ink and Monero orange. */
  const shade = (v: number, lit: boolean) => {
    const k = lit ? 1 : 0.25 + (v / 255) * 0.5;
    const mix = (a: number, b: number) => Math.round(a + (b - a) * k);
    return `rgb(${mix(54, 255)},${mix(50, 102)},${mix(58, 0)})`;
  };

  function draw() {
    if (!song) return;
    const cell = canvas.width / COLS, gap = 4;
    ctx.fillStyle = flash > 0 ? "#3d3842" : "#2b282d";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    const lit = new Set(step < 0 ? [] : [1 + step, 33 + step]);
    for (let i = 0; i < COLS * ROWS; i++) {
      const v = song.bytes[i] ?? 0, x = (i % COLS) * cell, y = Math.floor(i / COLS) * (GRID_H / ROWS);
      ctx.fillStyle = i < song.bytes.length ? shade(v, lit.has(i)) : "#2b282d";
      ctx.fillRect(x + gap, y + gap, cell - 2 * gap, GRID_H / ROWS - 2 * gap);
    }
    const bins = new Uint8Array(player?.analyser.frequencyBinCount ?? 32);
    player?.analyser.getByteFrequencyData(bins);
    const bars = 24, w = canvas.width / bars;
    for (let b = 0; b < bars; b++) {
      const h = Math.round(((bins[b] ?? 0) / 255) * (canvas.height - GRID_H - 16) / 8) * 8;
      ctx.fillStyle = b % 2 ? "#fb8c3c" : "#ff6600";
      ctx.fillRect(b * w + 2, canvas.height - h, w - 4, h);
    }
    flash = Math.max(0, flash - 1);
    if (player?.playing) requestAnimationFrame(draw);
  }

  function highlightChars() {
    charSpans.forEach((s, i) => s.classList.toggle("text-orange", step >= 0 && Math.floor(i / 3) === step));
  }

  function load() {
    const value = input.value.trim();
    const parsed = parseAddress(value);
    const next = parsed.ok ? songFromAddress(value) : null;
    input.setAttribute("aria-invalid", String(!!value && !next));
    $("#beat-message").textContent = value && !next ? t("bt_error") : "";
    $("[data-stage]").hidden = !next;
    if (!next) { player?.stop(); setPlaying(false); return; }
    const changed = value !== address;
    song = next; address = value;
    $("[data-info]").textContent = t("bt_info", { bpm: song.bpm, key: song.key, scale: t(`bt_scale_${song.scale}`) });
    charSpans = [...value].map((c) => Object.assign(document.createElement("span"), { textContent: c }));
    $("[data-chars]").replaceChildren(...charSpans);
    root.querySelector<HTMLButtonElement>("button[data-idle]")!.dataset.copyText = `${location.origin}${location.pathname}#${value}`;
    history.replaceState(null, "", `#${value}`);
    if (changed && player?.playing) player.play(song);
    step = -1;
    draw();
  }

  function setPlaying(on: boolean) {
    playBtn.querySelector("span")!.textContent = t(on ? "bt_stop" : "bt_play");
    playBtn.querySelector(".icon-play")!.classList.toggle("hidden", on);
    playBtn.querySelector(".icon-pause")!.classList.toggle("hidden", !on);
  }

  function ensurePlayer() {
    if (player) return player;
    player = new BeatPlayer();
    player.onStep = (s) => {
      step = s;
      if (song?.kick[s]) flash = 3;
      highlightChars();
    };
    return player;
  }

  playBtn.addEventListener("click", () => {
    const p = ensurePlayer();
    if (p.playing) { p.stop(); step = -1; highlightChars(); draw(); setPlaying(false); return; }
    p.play(song!);
    setPlaying(true);
    draw();
  });

  $("[data-download]").addEventListener("click", async () => {
    const p = ensurePlayer();
    const btn = $<HTMLButtonElement>("[data-download]"), label = btn.querySelector("span")!;
    if (!p.playing) { p.play(song!); setPlaying(true); draw(); }
    const recorder = new MediaRecorder(p.stream.stream);
    const chunks: Blob[] = [];
    recorder.ondataavailable = (e) => chunks.push(e.data);
    btn.disabled = true;
    label.textContent = t("bt_recording");
    recorder.start();
    await new Promise((r) => setTimeout(r, 2 * STEPS * (60 / song!.bpm / 4) * 1000));
    recorder.stop();
    await new Promise((r) => (recorder.onstop = r));
    const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(new Blob(chunks, { type: recorder.mimeType })), download: `xmr-beat-${address.slice(0, 8)}.webm` });
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 0);
    btn.disabled = false;
    label.textContent = t("bt_download");
  });

  input.addEventListener("input", load);
  $("[data-example]").addEventListener("click", () => { input.value = EXAMPLE_ADDRESS; load(); });
  input.value = decodeURIComponent(location.hash.slice(1));
  load();
</script>
