---
import { useTranslations, type Locale } from "../../i18n/ui";
import { EXAMPLE_ADDRESS } from "../../lib/monero";
import { encodeShare } from "../../lib/share";

interface Props { lang: Locale }
const t = useTranslations(Astro.props.lang);

// In the order they appear in URLs.
const PARAMS = [
  { param: "address", field: "address", label: t("f_address"), required: true },
  { param: "tx_amount", field: "amount", label: t("f_amount") },
  { param: "tx_payment_id", field: "paymentId", label: t("f_payment_id") },
  { param: "recipient_name", field: "name", label: t("f_name") },
  { param: "tx_description", field: "description", label: t("f_desc") },
];
const MODES = [
  { flag: "?raw", text: t("api_raw"), type: "text/plain" },
  { flag: "?rawqr", text: t("api_rawqr"), type: "image/png" },
  { flag: "&style=plain", text: t("api_plain"), type: "image/png" },
  { flag: "?embed", text: t("api_embed"), type: "text/html" },
];
const base = `${Astro.url.origin}/uri`;
const example = `${base}?address=${EXAMPLE_ADDRESS}&tx_amount=1.5`;
const exampleCode = encodeShare({ address: EXAMPLE_ADDRESS, amount: "1.5" });
const EXAMPLES = [
  { id: "api-raw", href: `${example}&raw`, prefix: "curl \"", suffix: "\"" },
  { id: "api-rawqr", href: `${example}&rawqr`, prefix: "curl \"", suffix: "\" -o qr.png" },
  { id: "api-embed", href: `${base}?embed#c=${exampleCode}`, prefix: "", suffix: "" },
];
const row = "grid gap-x-6 gap-y-1 py-3 sm:grid-cols-[150px_1fr_auto] sm:items-center";
const chip = "w-fit bg-ink-2 px-2 py-0.5 font-pixel text-xs uppercase tracking-wider text-ash";
---
<section id="api" class="mt-14" aria-labelledby="api-title" data-base={base} data-params={JSON.stringify(PARAMS.map(({ param, field }) => [param, field]))}>
  <h2 id="api-title" class="mb-2 font-pixel text-2xl text-orange">{t("api_title")}</h2>
  <p class="mb-6 max-w-[70ch] text-ash">{t("api_intro")}</p>

  <div class="border-l-4 border-orange bg-well px-6 py-3 shadow-[8px_8px_0_var(--color-shade)]">
    <div class="divide-y-2 divide-ink-2">
      {MODES.map((m) => (
        <div class={row}>
          <code class="font-mono text-[14px] text-good">{m.flag}</code>
          <span class="text-[15px] text-cream first-letter:uppercase">{m.text}</span>
          <span class={chip}>{m.type}</span>
        </div>
      ))}
    </div>

    <h3 class="mb-1 mt-5 font-pixel text-[11px] uppercase tracking-[0.2em] text-line">{t("api_params")}</h3>
    <div class="divide-y-2 divide-ink-2">
      <div class={row}>
        <code class="font-mono text-[14px] text-good">c</code>
        <span class="text-[15px] text-cream">{t("api_c")}</span>
      </div>
      {PARAMS.map((p) => (
        <div class={row}>
          <code class="font-mono text-[14px] text-good">{p.param}</code>
          <span class="text-[15px] text-cream">{p.label}</span>
          {p.required && <span class="w-fit border border-orange px-1.5 font-pixel text-xs uppercase tracking-wider text-orange">{t("api_required")}</span>}
        </div>
      ))}
    </div>

    <h3 class="mb-2 mt-5 font-pixel text-[11px] uppercase tracking-[0.2em] text-line">{t("api_example")}</h3>
    <div class="grid gap-2 pb-3">
      {EXAMPLES.map((e) => (
        <div class="flex items-start gap-3">
          <p class="min-w-0 flex-1 font-mono text-[13px] leading-relaxed text-cream [word-break:break-all]">
            <span class="select-none text-orange">&gt;_ </span>{e.prefix}<a id={e.id} class="text-cream underline decoration-line underline-offset-4 hover:text-orange" href={e.href} target="_blank" rel="noopener">{e.href}</a>{e.suffix}
          </p>
          <button type="button" data-api-copy class="flex shrink-0 cursor-pointer items-center gap-1.5 bg-ink-2 px-2.5 py-1 font-pixel text-xs uppercase tracking-wider text-cream hover:text-orange">
            <svg viewBox="0 0 8 8" width="10" height="10" class="text-orange" aria-hidden="true" shape-rendering="crispEdges"><path fill-rule="evenodd" d="M2 0h6v6H2zM3 1v4h4V1zM0 2h1v5h5v1H0z" fill="currentColor" /></svg>
            <span>{t("share_copy")}</span>
          </button>
        </div>
      ))}
    </div>
  </div>
  <p class="mt-4 text-sm text-ash">{t("api_privacy")}</p>
</section>

<script>
  import type { PaymentInput } from "../../lib/payment";
  import { subscribePayment } from "../../lib/payment-store";
  import { encodeShare } from "../../lib/share";

  const section = document.getElementById("api")!;
  const base = section.dataset.base!;
  const params: [string, keyof PaymentInput][] = JSON.parse(section.dataset.params!);
  const links = { raw: document.getElementById("api-raw") as HTMLAnchorElement, rawqr: document.getElementById("api-rawqr") as HTMLAnchorElement };
  const embed = document.getElementById("api-embed") as HTMLAnchorElement;
  const initial = { raw: links.raw.href, rawqr: links.rawqr.href, embed: embed.href };

  // Show the user's own request once the form is valid; otherwise keep the example.
  subscribePayment(({ input, ok }) => {
    for (const mode of ["raw", "rawqr"] as const) {
      let url = initial[mode];
      if (ok) {
        const q = new URLSearchParams();
        for (const [param, field] of params) if (input[field]?.trim()) q.set(param, input[field]!.trim());
        url = `${base}?${q}&${mode}`;
      }
      links[mode].href = links[mode].textContent = url;
    }
    const code = ok && encodeShare(input);
    embed.href = embed.textContent = code ? `${base}?embed#c=${code}` : initial.embed;
  });

  for (const btn of section.querySelectorAll<HTMLButtonElement>("[data-api-copy]")) {
    btn.addEventListener("click", () => navigator.clipboard.writeText(btn.previousElementSibling!.textContent!.replace(/^>_ /, "")).catch(() => {}));
  }
</script>
