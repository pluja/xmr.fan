---
import PixelIcon from "../PixelIcon.astro";
import TrustNote from "../ui/TrustNote.astro";
import { button, code, cx, field } from "../ui/styles";
import { LOCALE_NAMES, pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { BADGE_LANGS, BADGE_SIZES, BADGE_TEXTS, BADGE_THEMES } from "../../lib/badge";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, ["copied"]);
const badgeLang = (BADGE_LANGS as readonly string[]).includes(lang) ? lang : "en";
const tab = "relative inline-flex min-h-11 shrink-0 cursor-pointer items-center whitespace-nowrap px-3 font-pixel text-sm text-ash has-checked:bg-graphite has-checked:text-cream has-focus-visible:outline-2 has-focus-visible:outline-orange";
const group = "flex w-fit min-w-0 flex-wrap bg-well p-0.5 max-sm:w-full max-sm:flex-nowrap max-sm:overflow-x-auto";
const legend = "font-pixel text-xs tracking-[0.14em] text-ash uppercase";
const heading = "flex items-center gap-2.5 font-pixel text-sm tracking-[0.2em] text-cream uppercase";
---
<div id="badge-tool" class="grid grid-cols-1 gap-6" data-strings={strings}>
  <form data-form class="grid grid-cols-1 gap-x-8 gap-y-5 lg:grid-cols-2" novalidate>
    <fieldset class="min-w-0"><legend class={cx(legend, "mb-2")}>{t("bd_wording")}</legend>
      <div class={group}>{BADGE_TEXTS.map((k, i) => <label class={tab}><input type="radio" name="text" value={k} class="sr-only" checked={i === 0} />{t(`bd_text_${k}`)}</label>)}</div>
    </fieldset>
    <fieldset class="min-w-0"><legend class={cx(legend, "mb-2")}>{t("bd_theme")}</legend>
      <div class={group}>{BADGE_THEMES.map((k, i) => <label class={tab}><input type="radio" name="theme" value={k} class="sr-only" checked={i === 0} />{t(`bd_theme_${k}`)}</label>)}</div>
    </fieldset>
    <fieldset class="min-w-0"><legend class={cx(legend, "mb-2")}>{t("bd_size")}</legend>
      <div class={group}>{BADGE_SIZES.map((k, i) => <label class={tab}><input type="radio" name="size" value={k} class="sr-only" checked={i === 0} />{t(`bd_size_${k}`)}</label>)}</div>
    </fieldset>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-[minmax(0,9rem)_minmax(0,6rem)_minmax(0,1fr)]">
      <label class="grid content-start gap-2">
        <span class={legend}>{t("bd_language")}</span>
        <select name="lang" class={cx(field, "min-h-11 py-2 font-pixel text-sm")}>
          {BADGE_LANGS.map((l) => <option value={l} selected={l === badgeLang}>{LOCALE_NAMES[l]}</option>)}
        </select>
      </label>
      <label class="grid content-start gap-2">
        <span class={legend}>{t("bd_scale")}</span>
        <select name="scale" class={cx(field, "min-h-11 py-2 font-pixel text-sm")}>
          {[1, 2, 3].map((s) => <option value={s} selected={s === 1}>{s}×</option>)}
        </select>
      </label>
      <label class="col-span-2 grid content-start gap-2 sm:col-span-1">
        <span class={legend}>{t("bd_link")}</span>
        <input name="url" type="url" inputmode="url" placeholder="https://example.com/pay" autocomplete="off" spellcheck="false" class={cx(field, "min-h-11 py-2 font-mono text-sm")} />
      </label>
    </div>
  </form>

  <section class="grid gap-3" aria-labelledby="bd-preview-t">
    <h2 id="bd-preview-t" class={heading}><span class="size-2 bg-orange"></span>{t("bd_preview")}</h2>
    <div class="grid grid-cols-1 border-2 border-graphite md:grid-cols-2">
      <div data-preview class="grid min-h-48 place-items-center overflow-x-auto bg-well bg-[radial-gradient(#3a363f_1px,transparent_1px)] [background-size:12px_12px] p-6 [&_svg]:block [&_svg]:h-auto [&_svg]:max-w-full"></div>
      <div data-preview class="grid min-h-48 place-items-center overflow-x-auto bg-paper bg-[radial-gradient(#ebe1d4_1px,transparent_1px)] [background-size:12px_12px] p-6 [&_svg]:block [&_svg]:h-auto [&_svg]:max-w-full"></div>
    </div>
    <div class="flex flex-wrap gap-3">
      <button type="button" data-download="svg" class={button.primary}><PixelIcon name="download" size={16} /><span>{t("bd_svg")}</span></button>
      <button type="button" data-download="png" class={button.ghost}><PixelIcon name="download" size={16} class="text-orange" /><span>{t("bd_png")}</span></button>
    </div>
  </section>

  <section class="grid gap-3" aria-labelledby="bd-embed-t">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="bd-embed-t" class={heading}><span class="size-2 bg-orange"></span>{t("bd_embed")}</h2>
      <button type="button" data-copy-from="#bd-code" class={cx(button.ghost, "py-2")}><PixelIcon name="copy" size={16} class="text-orange" /><span>{t("bd_copy")}</span></button>
    </div>
    <p class="text-sm text-ash">{t("bd_embed_help")}</p>
    <code id="bd-code" class={cx(code, "max-h-32 overflow-y-auto")}></code>
  </section>

  <TrustNote class="border-t-2 border-graphite pt-4">{t("bd_private")}</TrustNote>
</div>

<script>
  import { bindCopyButtons } from "../ui/copy";
  import { readStrings } from "../../i18n/format";
  import { badgeSvg, badgeTitle, drawBadge, paintBadge, type BadgeLang, type BadgeOptions, type BadgeSize, type BadgeText, type BadgeTheme } from "../../lib/badge";

  const root = document.getElementById("badge-tool")!;
  const t = readStrings(root);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const form = $<HTMLFormElement>("[data-form]");
  const value = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement).value;

  const options = (): BadgeOptions => ({ size: value("size") as BadgeSize, theme: value("theme") as BadgeTheme, text: value("text") as BadgeText, lang: value("lang") as BadgeLang });
  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const safeUrl = () => { const u = value("url").trim(); return /^https?:\/\/\S+$/i.test(u) ? u : ""; };
  const scale = () => Number(value("scale"));

  function render() {
    const o = options();
    const pixels = drawBadge(o), title = badgeTitle(o);
    // The preview is never smaller than 2x, so the pixels are easy to judge.
    const preview = badgeSvg(pixels, Math.max(2, scale()), title);
    root.querySelectorAll("[data-preview]").forEach((el) => (el.innerHTML = preview));
    const svg = badgeSvg(pixels, scale(), title);
    const url = safeUrl();
    $("#bd-code").textContent = url ? `<a href="${escape(url)}" rel="noopener">${svg}</a>` : svg;
  }

  form.addEventListener("input", render);
  form.addEventListener("submit", (e) => e.preventDefault());
  root.querySelectorAll<HTMLButtonElement>("[data-download]").forEach((b) => b.addEventListener("click", () => {
    const o = options();
    const pixels = drawBadge(o);
    const a = document.createElement("a");
    a.download = `monero-${o.text}-${o.size}-${o.theme}.${b.dataset.download}`;
    if (b.dataset.download === "svg") {
      a.href = URL.createObjectURL(new Blob([badgeSvg(pixels, scale(), badgeTitle(o))], { type: "image/svg+xml" }));
    } else {
      const canvas = document.createElement("canvas");
      paintBadge(canvas, pixels, Math.max(4, scale()));
      a.href = canvas.toDataURL("image/png");
    }
    a.click();
  }));
  bindCopyButtons(root, t("copied"));
  render();
</script>
