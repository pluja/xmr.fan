---
import PixelIcon from "../PixelIcon.astro";
import AddressInput from "../ui/AddressInput.astro";
import TrustNote from "../ui/TrustNote.astro";
import { button, cx, field, link, message } from "../ui/styles";
import { pickStrings, useTranslations, type Key, type Locale } from "../../i18n/ui";
import { GLYPHS } from "../../lib/glyph-list";
import { NAMESPACES } from "../../lib/glyphs";
import { EXAMPLE_ADDRESS } from "../../lib/monero";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const NAME_KEYS = GLYPHS.map(([, name]) => `gl_n_${name}` as Key);
const strings = pickStrings(lang, ["gy_invalid", "gy_mine", "gy_working", "copied", ...NAME_KEYS]);
const EXAMPLES = [
  { label: "Monero", namespace: "monero", address: EXAMPLE_ADDRESS },
  { label: "Bitcoin", namespace: "bitcoin", address: "bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq" },
  { label: "Ethereum", namespace: "evm", address: "0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed" },
];
const heading = "flex items-center gap-2.5 font-pixel text-sm tracking-[0.2em] text-cream uppercase";
const tile = "grid w-[4.5rem] justify-items-center gap-1.5 border-2 border-graphite bg-well px-1 pt-3 pb-2 sm:w-24";
---
<div id="glyphs-tool" class="grid grid-cols-1 gap-6" data-strings={strings}>
  <section class="grid gap-2.5">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <label for="gy-address" class={heading}><span class="size-2 bg-orange"></span>{t("gy_address")}</label>
      <label class="flex items-center gap-2 text-sm text-ash">
        {t("gy_chain")}
        <select name="namespace" class={cx(field, "min-h-10 w-auto py-1.5 font-pixel text-sm")}>
          {NAMESPACES.map((ns) => <option value={ns}>{t(`gy_ns_${ns}`)}</option>)}
        </select>
      </label>
    </div>
    <AddressInput id="gy-address" name="address" placeholder="4… · bc1… · 0x…" paste={t("pl_paste")} describedby="gy-message" autofocus />
    <p id="gy-message" class={message}></p>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span class="text-ash">{t("bt_try")}:</span>
      {EXAMPLES.map((e) => <button type="button" data-example={e.address} data-namespace={e.namespace} class="min-h-10 cursor-pointer border-2 border-graphite px-3 text-sm text-ash hover:border-orange hover:text-orange">{e.label}</button>)}
    </div>
  </section>

  <div data-saved="none" class="group/saved contents">
    <p class="hidden items-center gap-3 border-2 border-good bg-[#1f3a2a] px-4 py-3 text-cream group-data-[saved=mine]/saved:flex">
      <PixelIcon name="check" size={18} class="shrink-0 text-good" /><span>{t("gy_mine")}</span>
    </p>
    <div class="hidden flex-wrap items-center gap-x-5 gap-y-2 border-2 border-bad bg-[#3a1f1f] px-4 py-3 group-data-[saved=stranger]/saved:flex">
      <p class="font-pixel text-lg text-bad">{t("gy_stranger")}</p>
      <p class="flex items-center gap-2 text-sm text-cream/80">{t("gy_yours")} <span data-yours class="text-2xl tracking-wider"></span></p>
    </div>
  </div>

  <section data-result data-state="empty" class="group/result grid justify-items-center gap-5 border-2 border-graphite bg-ink px-4 py-7 sm:px-6" aria-live="polite">
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-3" data-tiles>
      {[0, 1].map((group) => (
        <div class="flex gap-2 sm:gap-3">
          {[0, 1, 2].map((i) => (
            <figure class={tile} data-tile={group * 3 + i}>
              <span data-emoji class="text-4xl leading-none group-data-[state=working]/result:opacity-30 sm:text-5xl">·</span>
              <figcaption data-name class="min-h-4 text-center font-pixel text-xs leading-tight text-balance text-ash">&nbsp;</figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
    <p data-status class="text-sm text-ash">{t("gy_empty")}</p>
    <div class="hidden w-full max-w-xl gap-2 group-data-[state=done]/result:grid">
      <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 border-t-2 border-graphite pt-4">
        <p class="grid gap-0.5"><span class="font-pixel text-xs tracking-[0.14em] text-ash uppercase">{t("gy_share")}</span><span id="gy-text" class="text-2xl tracking-wider"></span></p>
        <button type="button" data-copy-from="#gy-text" class={cx(button.ghost, "py-2")}><PixelIcon name="copy" size={16} class="text-orange" /><span>{t("gy_copy")}</span></button>
      </div>
      <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
        <p class="grid gap-0.5"><span class="font-pixel text-xs tracking-[0.14em] text-ash uppercase">{t("gy_say")}</span><span id="gy-words" class="font-mono text-sm text-cream"></span></p>
        <button type="button" data-copy-from="#gy-words" class={cx(button.ghost, "py-2")}><PixelIcon name="copy" size={16} class="text-orange" /><span>{t("gy_copy")}</span></button>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t-2 border-graphite pt-4">
        <button type="button" data-save class={cx(button.ghost, "py-2")}><PixelIcon name="heart" size={16} class="text-orange" /><span>{t("gy_save")}</span></button>
        <button type="button" data-forget class={link} hidden>{t("gy_forget")}</button>
        <span data-save-note class="text-sm text-ash">{t("gy_save_note")}</span>
      </div>
    </div>
  </section>

  <section class="grid gap-4 md:grid-cols-2">
    <div class="grid content-start gap-3">
      <h2 class={heading}><span class="size-2 bg-orange"></span>{t("gy_how_t")}</h2>
      <ul class="grid gap-2.5 text-cream/80">
        {(["gy_how_1", "gy_how_2", "gy_how_3"] as const).map((k) => <li class="flex gap-2.5 leading-relaxed"><span class="mt-2.5 size-1.5 shrink-0 bg-orange"></span>{t(k)}</li>)}
      </ul>
    </div>
    <div class="grid content-start gap-3 border-l-4 border-orange bg-well px-5 py-4">
      <h2 class="font-pixel text-lg text-orange">{t("gy_dev_t")}</h2>
      <p class="text-sm leading-relaxed text-cream/80">{t("gy_dev_b")}</p>
      <p class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/glyphs/spec" class={link}>{t("gy_spec")}</a>
        <a href="/glyphs/address-glyphs-v1-list.json" class={link}>{t("gy_list")}</a>
        <a href="/glyphs/address-glyphs-v1-vectors.json" class={link}>{t("gy_vectors")}</a>
      </p>
    </div>
  </section>

  <div class="grid gap-2.5 border-t-2 border-graphite pt-4">
    <TrustNote>{t("gy_private")}</TrustNote>
    <TrustNote icon="info">{t("gy_check_note")}</TrustNote>
  </div>
</div>

<script>
  import { addressInput } from "../ui/address-input";
  import { bindCopyButtons } from "../ui/copy";
  import { readStrings } from "../../i18n/format";
  import { glyphText, glyphWords, guessNamespace, type Glyphs, type Namespace } from "../../lib/glyphs";
  import { parseAddress } from "../../lib/monero";

  const root = document.getElementById("glyphs-tool")!;
  const t = readStrings(root);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const result = $("[data-result]");
  const select = $<HTMLSelectElement>("select[name=namespace]");
  const box = addressInput($("[data-address-input]"), () => load());
  const worker = new Worker(new URL("../../lib/glyph-worker.ts", import.meta.url), { type: "module" });
  /** The visitor's own address, kept only in this browser. */
  const MINE = "xmrfan.glyphs.mine";
  const cache = new Map<string, Glyphs>();
  let run = 0, chosen = false, shown = "";

  const name = (english: string) => t(`gl_n_${english}`);
  const key = (ns: Namespace, address: string) => `${ns}:${address.trim()}`;

  function compute(ns: Namespace, address: string): Promise<Glyphs> {
    const k = key(ns, address);
    if (cache.has(k)) return Promise.resolve(cache.get(k)!);
    const id = ++run;
    return new Promise((resolve, reject) => {
      const onMessage = (e: MessageEvent) => {
        if (e.data.id !== id) return;
        worker.removeEventListener("message", onMessage);
        if (e.data.error) reject(new Error(e.data.error));
        else { cache.set(k, e.data.glyphs); resolve(e.data.glyphs); }
      };
      worker.addEventListener("message", onMessage);
      worker.postMessage({ id, namespace: ns, address });
    });
  }

  /** Format check: full validation for Monero, the address shape for the rest. */
  const valid = (ns: Namespace, address: string) =>
    ns === "monero" ? parseAddress(address).ok : ns === "solana" ? /^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(address) : guessNamespace(address) === ns;

  function paint(g: Glyphs | null) {
    root.querySelectorAll<HTMLElement>("[data-tile]").forEach((tile, i) => {
      tile.querySelector("[data-emoji]")!.textContent = g ? g.emoji[i] : "·";
      tile.querySelector("[data-name]")!.textContent = g ? name(g.names[i]) : " ";
    });
  }

  async function showSaved(g: Glyphs | null) {
    const raw = localStorage.getItem(MINE);
    const mine = raw ? (JSON.parse(raw) as { namespace: Namespace; address: string }) : null;
    $<HTMLButtonElement>("[data-save]").hidden = !!mine;
    $("[data-save-note]").hidden = !!mine;
    $<HTMLButtonElement>("[data-forget]").hidden = !mine;
    const status = $("[data-saved]");
    if (!mine || !g || !shown) { status.dataset.saved = "none"; return; }
    const same = key(mine.namespace, mine.address) === shown;
    status.dataset.saved = same ? "mine" : "stranger";
    if (!same) $("[data-yours]").textContent = glyphText(await compute(mine.namespace, mine.address));
  }

  async function load() {
    const address = box.field.value.trim();
    if (!chosen) { const guess = guessNamespace(address); if (guess) select.value = guess; }
    const ns = select.value as Namespace;
    const ok = !!address && valid(ns, address);
    box.field.setAttribute("aria-invalid", String(!!address && !ok));
    box.show(!address ? "" : ok ? "ok" : "error");
    $("#gy-message").textContent = address && !ok ? t("gy_invalid") : "";
    if (!ok) {
      shown = ""; result.dataset.state = "empty"; paint(null);
      $("[data-status]").hidden = false;
      return showSaved(null);
    }
    const k = key(ns, address);
    if (k === shown) return;
    shown = k;
    result.dataset.state = "working";
    $("[data-status]").hidden = false;
    $("[data-status]").textContent = t("gy_working");
    const g = await compute(ns, address);
    if (shown !== k) return;
    paint(g);
    result.dataset.state = "done";
    $("[data-status]").hidden = true;
    $("#gy-text").textContent = glyphText(g);
    $("#gy-words").textContent = glyphWords(g, g.names.map(name));
    result.setAttribute("aria-label", glyphWords(g, g.names.map(name)));
    history.replaceState(null, "", `#${ns}:${address}`);
    showSaved(g);
  }

  box.field.addEventListener("input", load);
  select.addEventListener("change", () => { chosen = true; load(); });
  root.querySelectorAll<HTMLButtonElement>("[data-example]").forEach((b) => b.addEventListener("click", () => {
    select.value = b.dataset.namespace!;
    chosen = false;
    box.set(b.dataset.example!);
    load();
  }));
  $("[data-save]").addEventListener("click", () => {
    if (!shown) return;
    localStorage.setItem(MINE, JSON.stringify({ namespace: select.value, address: box.field.value.trim() }));
    showSaved(cache.get(shown) ?? null);
  });
  $("[data-forget]").addEventListener("click", () => { localStorage.removeItem(MINE); showSaved(cache.get(shown) ?? null); });
  bindCopyButtons(root, t("copied"));

  const hash = decodeURIComponent(location.hash.slice(1));
  const at = hash.indexOf(":");
  if (at > 0 && (["monero", "bitcoin", "litecoin", "evm", "solana"] as string[]).includes(hash.slice(0, at))) {
    select.value = hash.slice(0, at);
    chosen = true;
    box.set(hash.slice(at + 1));
  }
  load();
</script>
