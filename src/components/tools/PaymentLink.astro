---
import { button, code, cx, field, fold, label, link, message } from "../ui/styles";
import PixelIcon from "../PixelIcon.astro";
import AddressInput from "../ui/AddressInput.astro";
import QrCode from "../ui/QrCode.astro";
import ResultPlaceholder from "../ui/ResultPlaceholder.astro";
import Slip from "../ui/Slip.astro";
import Step from "../ui/Step.astro";
import TrustNote from "../ui/TrustNote.astro";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { LIMITS, type PaymentInput } from "../../lib/payment";

interface Props { lang: Locale; initial?: PaymentInput }
const { lang, initial = { address: "" } } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "ok_address", "type_standard", "type_subaddress", "type_integrated", "warn_network",
  "err_chars", "err_length", "err_checksum", "err_prefix", "err_amount", "err_payment_id",
  "err_payment_id_integrated", "err_too_long", "copied", "qr_alt", "example_desc", "share_copy", "card_title",
  "pl_check_ends", "pl_fiat", "pl_copy_link",
]);
---
<form id="payment-link" class="group/pay grid gap-x-10 gap-y-7 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-y-8" data-strings={strings} data-lang={lang} data-empty novalidate>
    <section class="grid min-w-0 gap-2.5 lg:col-start-1">
      <div class="flex items-baseline justify-between gap-4">
        <Step as="label" for="pl-address" n="01" label={t("pl_step_address")} />
        <button type="button" id="example" class={link}>{t("try_example")}</button>
      </div>
      <AddressInput id="pl-address" name="address" value={initial.address} paste={t("pl_paste")} describedby="address-status" autofocus />
      <p id="address-status" class="text-sm empty:hidden" aria-live="polite"></p>
    </section>

    <details id="details" class:list={[fold, "order-3 min-w-0 lg:order-none lg:col-start-1"]}>
      <Step as="summary" n="02" label={t("pl_step_details")} optional={t("pl_optional")} />
      <div class="mt-4 grid gap-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="grid content-start gap-1.5">
          <label for="pl-amount" class="text-sm text-ash">{t("f_amount")}</label>
          <div class="relative">
            <input id="pl-amount" type="text" name="amount" value={initial.amount} inputmode="decimal" placeholder="0.05" autocomplete="off" class={cx(field, "pr-20 font-mono")} aria-describedby="amount-message amount-fiat" />
            <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 bg-graphite px-2.5 py-1 font-pixel text-xs text-orange">XMR</span>
          </div>
          <p id="amount-message" class={message}></p>
          <p id="amount-fiat" class="text-sm text-line empty:hidden"></p>
        </div>
        <div class="grid content-start gap-1.5">
          <label for="pl-name" class="text-sm text-ash">{t("f_name")}</label>
          <input id="pl-name" type="text" name="name" value={initial.name} maxlength={LIMITS.name} autocomplete="off" class={field} aria-describedby="name-message" />
          <p id="name-message" class={message}></p>
        </div>
      </div>
      <div class="grid gap-1.5">
        <label for="pl-description" class="text-sm text-ash">{t("f_desc")}</label>
        <div class="relative">
          <input id="pl-description" type="text" name="description" value={initial.description} maxlength={LIMITS.description} autocomplete="off" class={cx(field, "pr-24")} aria-describedby="description-message" />
          <span id="description-count" class="pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-line"></span>
        </div>
        <p id="description-message" class={message}></p>
      </div>
      {initial.paymentId && (
        <div class="grid gap-1.5">
          <label for="pl-payment-id" class="text-sm text-ash">{t("f_payment_id")}</label>
          <input id="pl-payment-id" type="text" name="paymentId" value={initial.paymentId} spellcheck="false" autocomplete="off" class={cx(field, "font-mono text-[13px]")} aria-describedby="paymentId-message" />
          <p id="paymentId-message" class={message}></p>
        </div>
      )}
      </div>
    </details>

    <details id="link" class:list={[fold, "order-4 min-w-0 lg:order-none lg:col-start-1"]}>
      <Step as="summary" n="03" label={t("pl_step_link")} />
      <div class="mt-2.5 grid gap-2.5">
      <div class="flex justify-end bg-transparent font-pixel text-[11px] uppercase lg:-mt-9" role="group">
        <div class="flex bg-well p-0.5">
          <button type="button" data-view="pretty" aria-pressed="true" class="cursor-pointer px-3 py-1 text-line aria-pressed:bg-graphite aria-pressed:text-cream">{t("pl_pretty")}</button>
          <button type="button" data-view="raw" aria-pressed="false" class="cursor-pointer px-3 py-1 text-line aria-pressed:bg-graphite aria-pressed:text-cream">{t("pl_raw")}</button>
        </div>
      </div>
      <output id="uri" class={cx(code, "min-h-24")}><span class="text-orange">monero:</span></output>
      </div>
    </details>

    <TrustNote class="order-5 lg:order-none lg:col-start-1">{t("pl_local")}</TrustNote>

  <div class="order-2 max-lg:group-data-empty/pay:hidden grid w-full max-w-[420px] content-start gap-5 justify-self-center lg:order-none lg:col-start-2 lg:row-span-5 lg:row-start-1 lg:max-w-none">
    <ResultPlaceholder icon="qr" text={t("pl_waiting")} class="hidden group-data-empty/pay:grid" />
    <Slip class="group-data-empty/pay:hidden">
      <div class={cx(label, "flex items-baseline justify-between gap-3")}>
        <span>{t("pl_request")}</span><span>{t("scan_to_pay")}</span>
      </div>
      <p id="slip-name" class="-mt-2 text-lg font-bold leading-tight empty:hidden"></p>
      <QrCode id="qr">
        <div class="grid justify-items-center gap-3 px-8 text-center text-sm text-slip-ink">
          <PixelIcon name="qr" size={56} class="text-peach" />
          <span>{t("pl_waiting")}</span>
        </div>
      </QrCode>
      <div id="slip-amount-row" class="flex flex-wrap items-baseline justify-between gap-x-3" hidden>
        <span id="slip-amount" class="font-pixel text-3xl"></span>
        <span id="slip-fiat" class="text-sm text-slip-ink"></span>
      </div>
      <p id="slip-desc" class="-mt-2 text-[15px] text-graphite empty:hidden"></p>
      <Fragment slot="footer">
        <span class={label}>{t("pl_to")}</span>
        <span id="slip-to" class="min-w-0 truncate font-mono text-[13px] font-normal">…</span>
        <span class="ml-auto font-pixel text-[11px] text-slip-ink">xmr.fan</span>
      </Fragment>
    </Slip>

    <button type="button" id="copy" class={cx(button.primary, "w-full py-4 text-[17px] group-data-empty/pay:hidden")} disabled>
      <PixelIcon name="copy" size={18} /><span>{t("pl_copy_link")}</span>
      <kbd id="copy-kbd" class="absolute right-4 hidden font-pixel text-[11px] text-ember sm:block">Ctrl C</kbd>
    </button>
    <div class="grid grid-cols-2 gap-3 group-data-empty/pay:hidden">
      <button type="button" id="download" class={button.ghost} disabled><PixelIcon name="download" size={16} class="text-orange" /><span>{t("pl_download")}</span></button>
      <button type="button" id="share" class={button.ghost} disabled aria-expanded="false" aria-controls="share-box"><PixelIcon name="share" size={16} class="text-orange" /><span>{t("share_btn")}</span></button>
    </div>
  </div>

  <section id="share-box" class="order-2 grid gap-4 border-l-4 border-orange bg-well p-5 lg:order-none lg:col-span-2" hidden>
    <h2 class="font-pixel text-lg text-orange">{t("share_t")}</h2>
    <div class="grid gap-1.5">
      <label for="share-link" class="text-sm text-ash">{t("share_link")}</label>
      <div class="flex flex-wrap gap-2">
        <input id="share-link" readonly class={cx(field, "min-w-0 flex-1 basis-64 font-mono text-[13px]")} />
        <button type="button" class={cx(button.ghost, "px-4")} data-copy="share-link"><span>{t("share_copy")}</span></button>
        <a id="share-preview" class={cx(button.ghost, "px-4")} target="_blank" rel="noopener">{t("share_preview")}</a>
      </div>
    </div>
    <div class="grid gap-1.5">
      <label for="share-embed" class="text-sm text-ash">{t("share_embed")}</label>
      <div class="flex flex-wrap items-start gap-2">
        <textarea id="share-embed" readonly rows="3" class={cx(field, "min-w-0 flex-1 basis-64 resize-none font-mono text-[13px] [word-break:break-all]")}></textarea>
        <button type="button" class={cx(button.ghost, "px-4")} data-copy="share-embed"><span>{t("share_copy")}</span></button>
      </div>
    </div>
    <p class="text-sm text-ash">{t("share_note")}</p>
  </section>
</form>


<script>
  import { readStrings } from "../../i18n/format";
  import type { Locale } from "../../i18n/ui";
  import { formatMoney } from "../../lib/currency";
  import { EXAMPLE_ADDRESS, EXAMPLE_AMOUNT, EXAMPLE_NAME } from "../../lib/monero";
  import { LIMITS, validatePayment, type PaymentField, type PaymentInput } from "../../lib/payment";
  import { publishPayment } from "../../lib/payment-store";
  import { chosenCurrency, getPrices } from "../../lib/price-client";
  import { drawQr, qrPng } from "../../lib/qr";
  import { qrBox } from "../ui/qr";
  import { encodeShare } from "../../lib/share";
  import { addressInput, shortAddressHtml } from "../ui/address-input";

  const form = document.getElementById("payment-link") as HTMLFormElement;
  const t = readStrings(form);
  const lang = form.dataset.lang as Locale;
  const $ = (id: string) => document.getElementById(id);
  const status = $("address-status")!, out = $("uri")!, showQr = qrBox($("qr")!);
  const address = addressInput(form.querySelector("[data-address-input]")!, () => render());
  const copyBtn = $("copy") as HTMLButtonElement, dlBtn = $("download") as HTMLButtonElement, shareBtn = $("share") as HTMLButtonElement;
  const shareBox = $("share-box")!, shareLink = $("share-link") as HTMLInputElement, shareEmbed = $("share-embed") as HTMLTextAreaElement;
  const copyLabel = copyBtn.querySelector("span")!;
  const FIELDS: PaymentField[] = ["address", "amount", "paymentId", "name", "description"];
  let uri = "", view: "pretty" | "raw" = "pretty", price: number | undefined;

  const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? "";
  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

  function setStatus(html: string, tone: "ok" | "error" | "") {
    status.innerHTML = html;
    status.style.color = tone === "ok" ? "var(--color-good)" : tone === "error" ? "var(--color-bad)" : "";
    address.show(tone);
  }

  function renderLink() {
    if (!uri) { out.innerHTML = `<span class="text-orange">monero:</span>`; return; }
    if (view === "raw") { out.textContent = uri; return; }
    const [base, query = ""] = uri.split("?");
    const params = query ? query.split("&").map((pair, i) => {
      const [k, v = ""] = pair.split("=");
      return `<br><span class="text-line">${i ? "&amp;" : "?"}${escape(k)}=</span><span class="text-good">${escape(v)}</span>`;
    }) : [];
    out.innerHTML = `<span class="text-orange">monero:</span><span class="text-cream">${escape(base.slice("monero:".length))}</span>${params.join("")}`;
  }

  function renderFiat(amount: string) {
    const n = Number(amount);
    const text = price && amount && n > 0 ? formatMoney(n * price, chosenCurrency(lang), lang) : "";
    $("amount-fiat")!.textContent = text ? t("pl_fiat", { value: text }) : "";
    $("slip-fiat")!.textContent = text ? `≈ ${text}` : "";
  }

  function render() {
    const input = Object.fromEntries(FIELDS.map((f) => [f, value(f)])) as unknown as PaymentInput;
    const result = validatePayment(input);
    const errors = result.ok ? [] : result.errors;
    const errorFor = (f: PaymentField) => errors.find((e) => e.field === f);

    const addressError = input.address.trim() ? errorFor("address") : undefined;
    const parsed = result.address;
    if (!input.address.trim()) setStatus("", "");
    else if (addressError) setStatus(escape(t(addressError.key, addressError.vars)), "error");
    else if (parsed?.ok && parsed.network !== "mainnet") setStatus(escape(t("warn_network", { net: parsed.network })), "error");
    else if (parsed?.ok) setStatus(`✓ ${escape(t("ok_address", { type: t(`type_${parsed.type}`) }))} <span style="color:var(--color-line)">· ${escape(t("pl_check_ends"))}</span>`, "ok");
    address.field.setAttribute("aria-invalid", String(!!addressError));

    for (const f of FIELDS.slice(1)) {
      const el = form.elements.namedItem(f) as HTMLInputElement | null;
      const msg = $(`${f}-message`);
      const err = errorFor(f);
      el?.setAttribute("aria-invalid", String(!!err));
      if (msg) msg.textContent = err ? t(err.key, err.vars) : "";
    }
    $("description-count")!.textContent = `${input.description?.length ?? 0} / ${LIMITS.description}`;

    uri = result.ok ? result.uri : "";
    copyBtn.disabled = dlBtn.disabled = shareBtn.disabled = !uri;
    form.toggleAttribute("data-empty", !uri);
    renderShare(input);
    renderLink();

    const amount = new URLSearchParams(uri.split("?")[1] ?? "").get("tx_amount") ?? "";
    $("slip-amount-row")!.hidden = !amount;
    $("slip-amount")!.textContent = amount ? `${amount} XMR` : "";
    $("slip-name")!.textContent = uri ? input.name?.trim() ?? "" : "";
    $("slip-desc")!.textContent = uri ? input.description?.trim() ?? "" : "";
    $("slip-to")!.innerHTML = uri ? shortAddressHtml(input.address.trim()) : "…";
    if (amount && !price) getPrices().then((p) => { price = p[chosenCurrency(lang)]; renderFiat(value("amount")); }).catch(() => {});
    renderFiat(errorFor("amount") ? "" : input.amount ?? "");

    showQr(uri, t("qr_alt"));
    publishPayment({ input, ok: result.ok });
  }

  // The share link carries the whole request after #, so the server never sees it.
  function renderShare(input: PaymentInput) {
    const code = uri ? encodeShare(input) : null;
    if (!code) { shareBox.hidden = true; shareBtn.setAttribute("aria-expanded", "false"); return; }
    const link = `${location.origin}${location.pathname}#c=${code}`;
    shareLink.value = link;
    ($("share-preview") as HTMLAnchorElement).href = link;
    const src = `${location.origin}/uri?embed#c=${code}`;
    shareEmbed.value = `<iframe src="${src}" title="${t("card_title")}" width="420" height="${EMBED_HEIGHT}" style="border:0;max-width:100%" loading="lazy"></iframe>`;
  }
  const EMBED_HEIGHT = 820;

  async function copyLink() {
    try {
      await navigator.clipboard.writeText(uri);
    } catch {
      getSelection()?.selectAllChildren(out);
      return;
    }
    copyLabel.textContent = t("copied");
    setTimeout(() => (copyLabel.textContent = t("pl_copy_link")), 1400);
  }

  shareBtn.addEventListener("click", () => {
    shareBox.hidden = !shareBox.hidden;
    shareBtn.setAttribute("aria-expanded", String(!shareBox.hidden));
    if (!shareBox.hidden) shareLink.select();
  });

  for (const btn of form.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const field = $(btn.dataset.copy!) as HTMLInputElement, label = btn.querySelector("span")!;
    btn.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(field.value); } catch { field.select(); return; }
      label.textContent = t("copied");
      setTimeout(() => (label.textContent = t("share_copy")), 1400);
    });
  }

  for (const btn of form.querySelectorAll<HTMLButtonElement>("[data-view]")) {
    btn.addEventListener("click", () => {
      view = btn.dataset.view as typeof view;
      form.querySelectorAll("[data-view]").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      renderLink();
    });
  }

  form.addEventListener("input", render);
  form.addEventListener("submit", (e) => e.preventDefault());

  $("example")!.addEventListener("click", () => {
    const example: Record<string, string> = {
      address: EXAMPLE_ADDRESS, amount: EXAMPLE_AMOUNT, name: EXAMPLE_NAME, description: t("example_desc"),
    };
    for (const [name, v] of Object.entries(example)) (form.elements.namedItem(name) as HTMLInputElement).value = v;
    ($("details") as HTMLDetailsElement).open = true;
    render();
  });

  copyBtn.addEventListener("click", copyLink);
  const mac = /Mac|iP(hone|ad)/.test(navigator.userAgent);
  $("copy-kbd")!.textContent = mac ? "⌘C" : "Ctrl C";
  // Ctrl/⌘+C with nothing selected and no field focused copies the payment link.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "c" || !(mac ? e.metaKey : e.ctrlKey) || !uri) return;
    if (getSelection()?.toString() || /^(INPUT|TEXTAREA)$/.test((document.activeElement as HTMLElement)?.tagName)) return;
    e.preventDefault();
    copyLink();
  });

  dlBtn.addEventListener("click", async () => {
    const png = await qrPng(drawQr(uri), 12);
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([png as BlobPart], { type: "image/png" }));
    a.download = "monero-payment-qr.png";
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 0);
  });

  // Small screens start with the optional steps folded, unless they already hold something.
  const wide = matchMedia("(min-width: 1024px)").matches;
  ($("details") as HTMLDetailsElement).open = wide || ["amount", "name", "description", "paymentId"].some((f) => value(f).trim());
  ($("link") as HTMLDetailsElement).open = wide;

  render(); // fields may be prefilled from the URL or restored by the browser
</script>
