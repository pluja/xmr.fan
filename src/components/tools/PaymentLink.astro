---
import Field from "../Field.astro";
import PixelIcon from "../PixelIcon.astro";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { LIMITS, type PaymentInput } from "../../lib/payment";

interface Props { lang: Locale; initial?: PaymentInput }
const { lang, initial = { address: "" } } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "ok_address", "type_standard", "type_subaddress", "type_integrated", "warn_network",
  "err_chars", "err_length", "err_checksum", "err_prefix", "err_amount", "err_payment_id",
  "err_payment_id_integrated", "err_too_long", "copy", "copied", "qr_alt", "example_desc", "share_copy", "card_title",
]);
---
<form id="payment-link" class="grid gap-7 md:grid-cols-[minmax(0,1fr)_280px]" data-strings={strings} novalidate>
  <div class="grid content-start gap-3.5">
    <Field label={t("f_address")}>
      <textarea name="address" rows="2" spellcheck="false" autocomplete="off" autocapitalize="off" class="field min-h-14 resize-y font-mono text-[13px] [word-break:break-all]" aria-describedby="address-status" autofocus>{initial.address}</textarea>
    </Field>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <p id="address-status" class="text-sm empty:hidden" aria-live="polite"></p>
      <button type="button" id="example" class="-my-1 cursor-pointer py-1 text-sm text-graphite underline">{t("try_example")}</button>
    </div>
    <div class="grid gap-3.5 sm:grid-cols-2">
      <Field label={t("f_amount")} messageId="amount-message">
        <input type="text" name="amount" value={initial.amount} inputmode="decimal" placeholder="0.05" autocomplete="off" class="field" aria-describedby="amount-message" />
      </Field>
      <Field label={t("f_name")} messageId="name-message">
        <input type="text" name="name" value={initial.name} maxlength={LIMITS.name} autocomplete="off" class="field" aria-describedby="name-message" />
      </Field>
    </div>
    <Field label={t("f_desc")} messageId="description-message">
      <input type="text" name="description" value={initial.description} maxlength={LIMITS.description} autocomplete="off" class="field" aria-describedby="description-message" />
    </Field>
    {initial.paymentId && (
      <Field label={t("f_payment_id")} messageId="paymentId-message">
        <input type="text" name="paymentId" value={initial.paymentId} spellcheck="false" autocomplete="off" class="field font-mono text-[13px]" aria-describedby="paymentId-message" />
      </Field>
    )}
    <output id="uri" class="block bg-ink p-3 font-mono text-xs leading-normal text-mint [word-break:break-all] empty:hidden"></output>
  </div>

  <div class="grid max-w-[300px] content-start gap-3 md:max-w-none">
    <figure class="border-2 border-ink bg-paper shadow-[6px_6px_0_var(--color-ink)]">
      <div id="qr" class="grid aspect-square place-items-center">
        <PixelIcon name="qr" size={56} class="text-peach" />
      </div>
      <figcaption class="flex items-baseline justify-between gap-3 border-t-2 border-ink px-3 py-2 font-pixel text-sm">
        <span>{t("scan_to_pay")}</span>
        <span id="qr-amount" class="text-right"></span>
      </figcaption>
    </figure>
    <button type="button" id="copy" class="btn mt-2" disabled><PixelIcon name="copy" size={16} /><span>{t("copy")}</span></button>
    <button type="button" id="download" class="btn btn-ghost" disabled><PixelIcon name="download" size={16} /><span>{t("download_qr")}</span></button>
    <button type="button" id="share" class="btn btn-ghost" disabled aria-expanded="false" aria-controls="share-box"><PixelIcon name="share" size={16} /><span>{t("share_btn")}</span></button>
  </div>

  <section id="share-box" class="grid gap-4 border-2 border-ink bg-paper p-4 md:col-span-2" hidden>
    <h2 class="font-pixel text-lg">{t("share_t")}</h2>
    <div class="grid gap-1.5">
      <label for="share-link" class="font-pixel text-sm">{t("share_link")}</label>
      <div class="flex flex-wrap gap-2">
        <input id="share-link" readonly class="field min-w-0 flex-1 basis-64 font-mono text-[13px]" />
        <button type="button" class="btn" data-copy="share-link"><span>{t("share_copy")}</span></button>
        <a id="share-preview" class="btn btn-ghost" target="_blank" rel="noopener">{t("share_preview")}</a>
      </div>
    </div>
    <div class="grid gap-1.5">
      <label for="share-embed" class="font-pixel text-sm">{t("share_embed")}</label>
      <div class="flex flex-wrap items-start gap-2">
        <textarea id="share-embed" readonly rows="3" class="field min-w-0 flex-1 basis-64 resize-none font-mono text-[12px] [word-break:break-all]"></textarea>
        <button type="button" class="btn" data-copy="share-embed"><span>{t("share_copy")}</span></button>
      </div>
    </div>
    <p class="text-sm text-graphite">{t("share_note")}</p>
  </section>
</form>

<style>
  /* The QR prints in like an old dot-matrix: top to bottom, in steps. */
  @media (prefers-reduced-motion: no-preference) {
    :global(#qr.reveal svg) { animation: qr-print 480ms steps(12) both; }
    @keyframes qr-print { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  }
</style>

<script>
  import { readStrings } from "../../i18n/format";
  import { EXAMPLE_ADDRESS, EXAMPLE_AMOUNT, EXAMPLE_NAME } from "../../lib/monero";
  import { validatePayment, type PaymentField, type PaymentInput } from "../../lib/payment";
  import { publishPayment } from "../../lib/payment-store";
  import { drawQr, qrPng, qrSvg } from "../../lib/qr";
  import { encodeShare } from "../../lib/share";

  const form = document.getElementById("payment-link") as HTMLFormElement;
  const t = readStrings(form);
  const $ = (id: string) => document.getElementById(id);
  const status = $("address-status")!, out = $("uri")!, qrBox = $("qr")!, qrAmount = $("qr-amount")!;
  const copyBtn = $("copy") as HTMLButtonElement, dlBtn = $("download") as HTMLButtonElement, shareBtn = $("share") as HTMLButtonElement;
  const shareBox = $("share-box")!, shareLink = $("share-link") as HTMLInputElement, shareEmbed = $("share-embed") as HTMLTextAreaElement;
  const copyLabel = copyBtn.querySelector("span")!;
  const placeholder = qrBox.innerHTML;
  const FIELDS: PaymentField[] = ["address", "amount", "paymentId", "name", "description"];
  let uri = "";

  const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? "";

  function setStatus(text: string, tone: "ok" | "error" | "") {
    status.textContent = text;
    status.classList.toggle("text-ok", tone === "ok");
    status.classList.toggle("text-danger", tone === "error");
  }

  function render() {
    const input = Object.fromEntries(FIELDS.map((f) => [f, value(f)])) as unknown as PaymentInput;
    const result = validatePayment(input);
    const errors = result.ok ? [] : result.errors;
    const errorFor = (f: PaymentField) => errors.find((e) => e.field === f);

    // Address: an empty field is just empty, not an error.
    const addressError = input.address.trim() ? errorFor("address") : undefined;
    const parsed = result.address;
    if (!input.address.trim()) setStatus("", "");
    else if (addressError) setStatus(t(addressError.key, addressError.vars), "error");
    else if (parsed?.ok && parsed.network !== "mainnet") setStatus(t("warn_network", { net: parsed.network }), "error");
    else if (parsed?.ok) setStatus(t("ok_address", { type: t(`type_${parsed.type}`) }), "ok");
    (form.elements.namedItem("address") as HTMLTextAreaElement).setAttribute("aria-invalid", String(!!addressError));

    for (const f of FIELDS.slice(1)) {
      const el = form.elements.namedItem(f) as HTMLInputElement | null;
      const msg = $(`${f}-message`);
      const err = errorFor(f);
      el?.setAttribute("aria-invalid", String(!!err));
      if (msg) msg.textContent = err ? t(err.key, err.vars) : "";
    }

    const wasEmpty = !uri;
    uri = result.ok ? result.uri : "";
    copyBtn.disabled = dlBtn.disabled = shareBtn.disabled = !uri;
    renderShare(input);
    out.textContent = uri;
    const amount = new URLSearchParams(uri.split("?")[1] ?? "").get("tx_amount");
    qrAmount.textContent = amount ? `${amount} XMR` : "";
    if (!uri) {
      qrBox.innerHTML = placeholder;
      qrBox.classList.remove("reveal");
    } else {
      const drawing = drawQr(uri);
      // Module gaps need at least ~7 physical pixels per module, or they blur into gray.
      const gaps = (qrBox.clientWidth / drawing.size) * devicePixelRatio >= 7;
      qrBox.innerHTML = qrSvg(drawing, t("qr_alt"), { gaps });
      qrBox.classList.toggle("reveal", wasEmpty); // animate only when the code first appears
    }
    publishPayment({ input, ok: result.ok });
  }

  // The share link carries the whole request after #, so the server never sees it.
  function renderShare(input: PaymentInput) {
    const code = uri ? encodeShare(input) : null;
    if (!code) { shareBox.hidden = true; shareBtn.setAttribute("aria-expanded", "false"); return; }
    const link = `${location.origin}${location.pathname}#c=${code}`;
    shareLink.value = link;
    ($("share-preview") as HTMLAnchorElement).href = link;
    const src = `${location.origin}/uri?embed#c=${code}`;
    shareEmbed.value = `<iframe src="${src}" title="${t("card_title")}" width="420" height="${EMBED_HEIGHT}" style="border:0;max-width:100%" loading="lazy"></iframe>`;
  }
  const EMBED_HEIGHT = 820;

  shareBtn.addEventListener("click", () => {
    shareBox.hidden = !shareBox.hidden;
    shareBtn.setAttribute("aria-expanded", String(!shareBox.hidden));
    if (!shareBox.hidden) shareLink.select();
  });

  for (const btn of form.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const field = $(btn.dataset.copy!) as HTMLInputElement, label = btn.querySelector("span")!;
    btn.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(field.value); } catch { field.select(); return; }
      label.textContent = t("copied");
      setTimeout(() => (label.textContent = t("share_copy")), 1400);
    });
  }

  form.addEventListener("input", render);
  form.addEventListener("submit", (e) => e.preventDefault());

  $("example")!.addEventListener("click", () => {
    const example: Record<string, string> = {
      address: EXAMPLE_ADDRESS, amount: EXAMPLE_AMOUNT, name: EXAMPLE_NAME, description: t("example_desc"),
    };
    for (const [name, v] of Object.entries(example)) (form.elements.namedItem(name) as HTMLInputElement).value = v;
    render();
  });

  copyBtn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(uri);
    } catch {
      // Clipboard API unavailable (e.g. insecure context): select the text instead.
      getSelection()?.selectAllChildren(out);
      return;
    }
    copyLabel.textContent = t("copied");
    setTimeout(() => (copyLabel.textContent = t("copy")), 1400);
  });

  dlBtn.addEventListener("click", async () => {
    const png = await qrPng(drawQr(uri), 12);
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([png as BlobPart], { type: "image/png" }));
    a.download = "monero-payment-qr.png";
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 0);
  });

  render(); // fields may be prefilled from the URL or restored by the browser
</script>
