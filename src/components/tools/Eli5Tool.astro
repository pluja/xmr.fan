---
import PixelIcon from "../PixelIcon.astro";
import { localePath, pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { MONERO_LOGO } from "../../lib/qr";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "el_btc", "el_xmr", "el_4_guess_1", "el_4_guess_2", "el_4_guess_3", "el_min", "el_from", "el_to", "el_amount", "el_linked",
  "el_blockchain", "el_your_address", "el_your_wallet", "el_in", "el_out", "el_fee", "el_valid", "el_refused",
]);
const CHAPTERS = [
  { n: 1, scene: "send" },
  { n: 2, scene: "network" },
  { n: 3, scene: "ledger" },
  { n: 4, scene: "ring", term: "el_4_term" },
  { n: 5, scene: "stealth", term: "el_5_term" },
  { n: 6, scene: "balance", term: "el_6_term" },
  { n: 7, scene: "fungible", term: "el_7_term" },
  { n: 8, scene: "seed", term: "el_8_term" },
] as const;
const BITCOIN_LOGO = [
  "....#####....", "..#########..", ".###########.", ".####w#w####.", "####wwww#####", "####w###w####", "####wwww#####",
  "####w###w####", "####wwww#####", ".####w#w####.", ".###########.", "..#########..", "....#####....",
];
/** Pixel logos as SVG: each letter of the bitmap maps to a color. */
const pixelSvg = (rows: string[], colors: Record<string, string>) =>
  `<svg viewBox="0 0 13 13" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true">${rows.flatMap((row, y) => [...row].map((ch, x) => (colors[ch] ? `<rect x="${x}" y="${y}" width="1" height="1" fill="${colors[ch]}"/>` : ""))).join("")}</svg>`;
const LOGOS = {
  public: pixelSvg(BITCOIN_LOGO, { "#": "#f7931a", w: "#fff" }),
  sealed: pixelSvg(MONERO_LOGO, { o: "#ff6600", k: "#4c4c4c", w: "#fff" }),
};
const TRY = [
  { href: localePath(lang, "/uri"), label: t("el_try_uri"), icon: "qr" },
  { href: localePath(lang, "/live"), label: t("el_try_live"), icon: "notes" },
  { href: localePath(lang, "/donate"), label: t("el_try_donate"), icon: "heart" },
] as const;
---
<div id="eli5-tool" class="grid gap-10" data-strings={strings}>
  <p class="max-w-[60ch] text-lg">{t("el_intro")}</p>

  {CHAPTERS.map(({ n, scene, ...rest }) => (
    <section class="grid items-center gap-4 md:grid-cols-2 md:gap-8">
      <div class:list={["grid gap-2", n % 2 === 0 && "md:order-last"]}>
        <h2 class="flex items-baseline gap-3 font-pixel text-xl leading-tight">
          <span class="grid size-8 shrink-0 place-items-center bg-ink text-base text-orange">{n}</span>
          {t(`el_${n}_t`)}
        </h2>
        <p class="max-w-[52ch]">{t(`el_${n}_b`)}</p>
        {"term" in rest && (
          <p class="flex flex-wrap items-center gap-2 text-sm">
            <span class="font-pixel text-xs text-graphite">{t("el_term")}:</span>
            <span class="bg-ink px-2 py-0.5 font-pixel text-orange">{t(rest.term)}</span>
          </p>
        )}
        {scene === "ledger" && (
          <div class="mt-1 flex w-fit border-2 border-ink bg-cream font-pixel shadow-[3px_3px_0_var(--color-ink)]" role="group">
            <button type="button" data-ledger="public" aria-pressed="true" class="flex cursor-pointer items-center gap-2 px-3.5 py-1.5 text-graphite transition-colors aria-pressed:bg-ink [&_svg]:opacity-55 [&_svg]:grayscale [&_svg]:transition aria-pressed:[&_svg]:opacity-100 aria-pressed:[&_svg]:grayscale-0 aria-pressed:text-[#f7931a]"><Fragment set:html={LOGOS.public} />{t("el_btc")}</button>
            <button type="button" data-ledger="sealed" aria-pressed="false" class="flex cursor-pointer items-center gap-2 px-3.5 py-1.5 text-graphite transition-colors aria-pressed:bg-ink [&_svg]:opacity-55 [&_svg]:grayscale [&_svg]:transition aria-pressed:[&_svg]:opacity-100 aria-pressed:[&_svg]:grayscale-0 border-l-2 border-ink aria-pressed:text-flame"><Fragment set:html={LOGOS.sealed} />{t("el_xmr")}</button>
          </div>
        )}
        {scene === "ring" && <p data-ring-message class="font-pixel text-sm text-graphite" aria-live="polite">{t("el_4_hint")}</p>}
      </div>
      <canvas data-scene={scene} class:list={["block w-full border-2 border-ink bg-ink shadow-[6px_6px_0_var(--color-graphite)] [aspect-ratio:96/54] [image-rendering:pixelated]", scene === "ring" && "cursor-pointer"]}></canvas>
    </section>
  ))}

  <section class="grid gap-3 border-t-2 border-dashed border-ink pt-8">
    <h2 class="font-pixel text-xl">{t("el_try_t")}</h2>
    <p>{t("el_try_b")}</p>
    <div class="flex flex-wrap gap-2">
      {TRY.map((l) => <a href={l.href} class="btn"><PixelIcon name={l.icon} size={16} /><span>{l.label}</span></a>)}
    </div>
  </section>
</div>


<script>
  import { balanceScene, fungibleScene, ledgerScene, networkScene, ringScene, Scene, seedScene, sendScene, stealthScene } from "./eli5-scenes";
  import { readStrings } from "../../i18n/format";

  const root = document.getElementById("eli5-tool")!;
  const t = readStrings(root);
  const canvas = (name: string) => root.querySelector<HTMLCanvasElement>(`[data-scene=${name}]`)!;

  new Scene(canvas("send"), sendScene({ minutes: t("el_min") }));
  new Scene(canvas("network"), networkScene({ minutes: t("el_min"), blockchain: t("el_blockchain") }));
  new Scene(canvas("stealth"), stealthScene({ address: t("el_your_address"), blockchain: t("el_blockchain") }));
  new Scene(canvas("balance"), balanceScene({ in: t("el_in"), out: t("el_out"), fee: t("el_fee"), valid: t("el_valid") }));
  new Scene(canvas("fungible"), fungibleScene({ btc: t("el_btc"), xmr: t("el_xmr"), refused: t("el_refused") }));
  new Scene(canvas("seed"), seedScene({ wallet: t("el_your_wallet") }));

  const ledger = ledgerScene({ from: t("el_from"), to: t("el_to"), amount: t("el_amount"), linked: (n) => t("el_linked", { n }) });
  new Scene(canvas("ledger"), ledger.draw);
  const ledgerButtons = root.querySelectorAll<HTMLButtonElement>("[data-ledger]");
  ledgerButtons.forEach((b) => b.addEventListener("click", () => {
    ledger.state.sealed = b.dataset.ledger === "sealed";
    ledgerButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === b)));
  }));

  const ring = ringScene({ valid: t("el_valid") });
  const ringStage = new Scene(canvas("ring"), ring.draw);
  const message = root.querySelector<HTMLElement>("[data-ring-message]")!;
  let guesses = 0;
  canvas("ring").addEventListener("click", (e) => {
    const { x, y } = ringStage.point(e);
    const i = ring.hit(x, y);
    if (i < 0) return;
    ring.state.picked = i;
    ring.state.pickedAt = ringStage.time;
    message.textContent = t(`el_4_guess_${(guesses++ % 3) + 1}`);
  });
</script>
