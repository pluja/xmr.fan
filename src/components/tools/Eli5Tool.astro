---
import PixelIcon from "../PixelIcon.astro";
import { localePath, pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { MONERO_LOGO } from "../../lib/qr";
import { button, chip, cx, link, tone } from "../ui/styles";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "el_btc", "el_xmr", "el_4_guess_1", "el_4_guess_2", "el_4_guess_3", "el_min", "el_from", "el_to", "el_amount", "el_linked",
  "el_blockchain", "el_your_address", "el_your_wallet", "el_in", "el_out", "el_fee", "el_valid", "el_refused",
]);
const CHAPTERS = [
  { n: 1, scene: "send" },
  { n: 2, scene: "network" },
  { n: 3, scene: "ledger" },
  { n: 4, scene: "ring", term: "el_4_term" },
  { n: 5, scene: "stealth", term: "el_5_term" },
  { n: 6, scene: "balance", term: "el_6_term" },
  { n: 7, scene: "fungible", term: "el_7_term" },
  { n: 8, scene: "seed", term: "el_8_term" },
] as const;
const BITCOIN_LOGO = [
  "....#####....", "..#########..", ".###########.", ".####w#w####.", "####wwww#####", "####w###w####", "####wwww#####",
  "####w###w####", "####wwww#####", ".####w#w####.", ".###########.", "..#########..", "....#####....",
];
/** Pixel logos as SVG: each letter of the bitmap maps to a color. */
const pixelSvg = (rows: string[], colors: Record<string, string>) =>
  `<svg viewBox="0 0 13 13" width="18" height="18" shape-rendering="crispEdges" aria-hidden="true">${rows.flatMap((row, y) => [...row].map((ch, x) => (colors[ch] ? `<rect x="${x}" y="${y}" width="1" height="1" fill="${colors[ch]}"/>` : ""))).join("")}</svg>`;
const LOGOS = {
  public: pixelSvg(BITCOIN_LOGO, { "#": "#f7931a", w: "#fff" }),
  sealed: pixelSvg(MONERO_LOGO, { o: "#ff6600", k: "#4c4c4c", w: "#fff" }),
};
const WALLETS = "getmonero.org";
const [tryBefore, tryAfter] = t("el_try_b").split(WALLETS);
const sceneBox = "block w-full border-2 border-graphite bg-ink shadow-[8px_8px_0_var(--color-shade)] [aspect-ratio:96/54] [image-rendering:pixelated]";
const ledgerButton = "flex min-h-11 cursor-pointer items-center gap-2 px-4 text-ash transition-colors hover:text-cream aria-pressed:bg-graphite [&_svg]:opacity-55 [&_svg]:grayscale [&_svg]:transition aria-pressed:[&_svg]:opacity-100 aria-pressed:[&_svg]:grayscale-0";
---
<div id="eli5-tool" class="grid gap-12 sm:gap-14" data-strings={strings}>
  <p class="max-w-[60ch] text-lg text-cream">{t("el_intro")}</p>

  {CHAPTERS.map(({ n, scene, ...rest }) => (
    <section class="grid items-center gap-5 md:grid-cols-2 md:gap-10" aria-labelledby={`el-${n}`}>
      <div class:list={["grid content-center gap-3", n % 2 === 0 && "md:order-last"]}>
        <p class="font-pixel text-sm tracking-[0.2em] text-orange" aria-hidden="true">{String(n).padStart(2, "0")}<span class="text-ash/60"> / {String(CHAPTERS.length).padStart(2, "0")}</span></p>
        <h2 id={`el-${n}`} class="font-pixel text-xl leading-snug text-cream sm:text-2xl">{t(`el_${n}_t`)}</h2>
        <p class="max-w-[52ch] leading-relaxed text-cream/80">{t(`el_${n}_b`)}</p>
        {"term" in rest && (
          <p class="flex flex-wrap items-center gap-2 text-sm text-ash">
            {t("el_term")}:
            <span class={cx(chip, tone.accent, "font-mono text-sm normal-case tracking-normal")}>{t(rest.term)}</span>
          </p>
        )}
      </div>
      <div class="grid gap-4">
        {scene === "ledger" && (
          <div class="flex w-fit border-2 border-graphite font-pixel" role="group" aria-label={t("el_3_t")}>
            <button type="button" data-ledger="public" aria-pressed="true" class={cx(ledgerButton, "aria-pressed:text-[#f7931a]")}><Fragment set:html={LOGOS.public} />{t("el_btc")}</button>
            <button type="button" data-ledger="sealed" aria-pressed="false" class={cx(ledgerButton, "border-l-2 border-graphite aria-pressed:text-orange")}><Fragment set:html={LOGOS.sealed} />{t("el_xmr")}</button>
          </div>
        )}
        {scene === "ring" ? (
          <canvas data-scene={scene} tabindex="0" role="button" aria-label={t("el_4_hint")} class={cx(sceneBox, "cursor-pointer hover:border-orange focus-visible:border-orange focus-visible:outline-none")}></canvas>
        ) : (
          <canvas data-scene={scene} class={sceneBox}></canvas>
        )}
        {scene === "ring" && <p data-ring-message class="flex items-center gap-2.5 font-pixel text-base text-peach" aria-live="polite"><span class="size-2 shrink-0 bg-orange motion-safe:animate-blink" aria-hidden="true"></span><span data-ring-text>{t("el_4_hint")}</span></p>}
      </div>
    </section>
  ))}

  <section class="grid gap-4 border-t-2 border-graphite pt-8" aria-labelledby="el-try">
    <h2 id="el-try" class="font-pixel text-xl leading-snug text-cream sm:text-2xl">{t("el_try_t")}</h2>
    <p class="leading-relaxed text-cream/80">{tryBefore}<a href="https://www.getmonero.org/downloads/" target="_blank" rel="noopener noreferrer" class={cx(link, "text-base")}>{WALLETS}</a>{tryAfter}</p>
    <a href={localePath(lang, "/uri")} class={cx(button.primary, "w-fit max-sm:w-full")}><PixelIcon name="qr" size={18} /><span>{t("el_try_uri")}</span></a>
  </section>
</div>


<script>
  import { balanceScene, fungibleScene, ledgerScene, networkScene, ringScene, Scene, seedScene, sendScene, stealthScene } from "./eli5-scenes";
  import { readStrings } from "../../i18n/format";

  const root = document.getElementById("eli5-tool")!;
  const t = readStrings(root);
  const canvas = (name: string) => root.querySelector<HTMLCanvasElement>(`[data-scene=${name}]`)!;

  new Scene(canvas("send"), sendScene({ minutes: t("el_min") }));
  new Scene(canvas("network"), networkScene({ minutes: t("el_min"), blockchain: t("el_blockchain") }));
  new Scene(canvas("stealth"), stealthScene({ address: t("el_your_address"), blockchain: t("el_blockchain") }));
  new Scene(canvas("balance"), balanceScene({ in: t("el_in"), out: t("el_out"), fee: t("el_fee"), valid: t("el_valid") }));
  new Scene(canvas("fungible"), fungibleScene({ btc: t("el_btc"), xmr: t("el_xmr"), refused: t("el_refused") }));
  new Scene(canvas("seed"), seedScene({ wallet: t("el_your_wallet") }));

  const ledger = ledgerScene({ from: t("el_from"), to: t("el_to"), amount: t("el_amount"), linked: (n) => t("el_linked", { n }) });
  new Scene(canvas("ledger"), ledger.draw);
  const ledgerButtons = root.querySelectorAll<HTMLButtonElement>("[data-ledger]");
  ledgerButtons.forEach((b) => b.addEventListener("click", () => {
    ledger.state.sealed = b.dataset.ledger === "sealed";
    ledgerButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === b)));
  }));

  const ring = ringScene({ valid: t("el_valid") });
  const ringStage = new Scene(canvas("ring"), ring.draw);
  const message = root.querySelector<HTMLElement>("[data-ring-text]")!;
  let guesses = 0;
  const pick = (i: number) => {
    ring.state.picked = i;
    ring.state.pickedAt = ringStage.time;
    message.textContent = t(`el_4_guess_${(guesses++ % 3) + 1}`);
  };
  canvas("ring").addEventListener("click", (e) => {
    const { x, y } = ringStage.point(e);
    const i = ring.hit(x, y);
    if (i >= 0) pick(i);
  });
  canvas("ring").addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    e.preventDefault();
    pick(Math.floor(Math.random() * ring.count));
  });
</script>
