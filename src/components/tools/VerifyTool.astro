---
import PixelIcon from "../PixelIcon.astro";
import NodeSource from "../live/NodeSource.astro";
import AddressInput from "../ui/AddressInput.astro";
import Button from "../ui/Button.astro";
import Printer from "../ui/Printer.astro";
import Receipt from "../ui/Receipt.astro";
import Stamp from "../ui/Stamp.astro";
import StatTile from "../ui/StatTile.astro";
import Step from "../ui/Step.astro";
import TrustNote from "../ui/TrustNote.astro";
import { chip, cx, field, fieldLabel, label, link, message, tone } from "../ui/styles";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const ERRORS = ["bad-tx", "bad-key", "bad-address", "bad-signature-format", "bad-signature", "no-tx-pubkey", "no-outputs", "commitment-mismatch", "unsupported-tx-type"].map((e) => `v_err_${e}`);
const strings = pickStrings(lang, [
  "v_checking", "v_printer_idle", "v_paid_t", "v_fail_t", "v_chip_key", "v_chip_out", "v_chip_in", "v_via", "v_paid_sub", "v_pool_sub", "v_st_yes", "v_st_in_blocks", "v_st_pending",
  "v_err_txid", "v_err_address", "v_err_secret", "v_err_network", "v_err_not_found", "live_error", "copied", "v_share", ...ERRORS,
] as never);
const mono = "font-mono text-[13px]";
---
<div id="verify-tool" class="grid grid-cols-1 gap-8" data-strings={strings} data-lang={lang}>
  <form data-form class="grid grid-cols-1 gap-7" novalidate>
    <section class="grid gap-2.5">
      <Step as="label" for="v-txid" n="01" label={t("v_txid")} />
      <input id="v-txid" name="txid" spellcheck="false" autocomplete="off" autocapitalize="off" class={cx(field, mono)} aria-describedby="txid-message" autofocus />
      <p id="txid-message" class={message}></p>
    </section>

    <div class="grid grid-cols-1 gap-7 lg:grid-cols-2">
      <section class="grid content-start gap-2.5">
        <div class="flex items-baseline justify-between gap-4">
          <Step as="label" for="v-address" n="02" label={t("v_address")} />
          <span data-address-ok class="flex items-center gap-1.5 text-sm text-good" hidden><PixelIcon name="check" size={12} />{t("v_valid_address")}</span>
        </div>
        <AddressInput id="v-address" name="address" paste={t("pl_paste")} describedby="address-message" />
        <p id="address-message" class={message}></p>
      </section>

      <section class="grid content-start gap-2.5">
        <Step as="label" for="v-secret" n="03" label={t("v_secret")} />
        <div class="relative">
          <textarea id="v-secret" name="secret" rows="3" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={t("v_secret_placeholder")} class={cx(field, mono, "min-h-[4.6rem] resize-y pr-32 break-all")} aria-describedby="secret-message"></textarea>
          <span data-kind class={cx(chip, tone.accent, "absolute top-3 right-3")} hidden><svg viewBox="0 0 8 8" width="10" height="10" aria-hidden="true" shape-rendering="crispEdges"><path d="M0 2h4v4H0zM4 3h4v2H4zM6 5h1v2H6zM1 3v2h2V3z" fill="currentColor" fill-rule="evenodd" /></svg><span></span></span>
        </div>
        <p id="secret-message" class={message}></p>
        <div data-message-field class="grid gap-1.5" hidden>
          <label for="v-message" class={fieldLabel}>{t("v_message")}</label>
          <input id="v-message" name="message" autocomplete="off" class={field} />
        </div>
      </section>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <Button type="submit">{t("v_check")}</Button>
      <button type="button" data-example class={cx(link, "text-ash")}>{t("try_example")}</button>
      <button type="button" data-where-toggle class={cx(link, "sm:ml-auto")} aria-expanded="false" aria-controls="where">{t("v_where_t")}</button>
    </div>
    <p id="where" class="-mt-3 border-l-4 border-orange bg-well px-5 py-4 text-[15px] text-ash" hidden>{t("v_where")}</p>
  </form>

  <Printer idle={t("v_printer_idle")} aria-live="polite">
    <Receipt>
      <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
        <div class="grid min-w-0 flex-1 basis-64 gap-1">
          <span class={cx(label, "text-[10px]")}>{t("v_receipt")} · <span data-via></span></span>
          <p data-show="ok" class="flex items-baseline gap-2.5"><span data-amount class="font-pixel text-5xl leading-none"></span><span class="font-pixel text-xl text-flame">XMR</span></p>
          <p data-show="ok" class="text-[14px] text-graphite">{t("v_received_by")} <span data-recipient class="font-mono text-ink"></span> · <span data-subtitle></span></p>
          <p data-show="fail" data-reason class="text-[16px] text-danger"></p>
        </div>
        <Stamp class="mt-1 mr-2 shrink-0" />
      </div>
      <div data-show="ok" class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <StatTile label={t("v_st_confirmations")}><span data-confirmations></span></StatTile>
        <StatTile label={t("v_st_outputs")}><span data-outputs></span></StatTile>
        <StatTile label={t("v_st_mined")}><span data-mined class="text-[15px]"></span></StatTile>
        <StatTile label={t("v_st_spendable")}><span data-spendable class="flex items-center gap-2 text-[15px]"></span></StatTile>
      </div>
      <Fragment slot="footer">
        <span class={cx(label, "text-[10px]")}>TX</span>
        <span data-tx class="min-w-0 truncate font-mono text-[12px]">…</span>
        <span class={cx(label, "ml-auto text-[10px]")}>xmr.fan</span>
      </Fragment>
    </Receipt>
    <div data-share class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2" hidden>
      <Button variant="ghost" data-copy-check><PixelIcon name="copy" size={16} class="text-orange" /><span>{t("v_share")}</span></Button>
      <p class="text-xs text-slip-ink">{t("v_share_note")}</p>
    </div>
  </Printer>

  <div class="grid gap-3 border-t-2 border-graphite pt-5">
    <TrustNote>{t("v_privacy")}</TrustNote>
    <NodeSource lang={lang} dark />
  </div>
</div>

<script>
  import { liveTask } from "../live/live";
  import { addressInput, shortAddressHtml } from "../ui/address-input";
  import { printer } from "../ui/printer";
  import { readStrings } from "../../i18n/format";
  import type { Locale } from "../../i18n/ui";
  import { EXAMPLE_PAYMENT } from "../../lib/examples";
  import { parseAddress, picoToXmr } from "../../lib/monero";
  import { call, customNode, getInfo } from "../../lib/node-client";
  import { checkTxKey, checkTxProof, isTxid, parseTxKey, txFromJson, type PaymentCheck } from "../../lib/txproof";

  const root = document.getElementById("verify-tool")!;
  const t = readStrings(root);
  const lang = root.dataset.lang as Locale;
  const form = root.querySelector<HTMLFormElement>("[data-form]")!;
  const box = root.querySelector<HTMLElement>("[data-printer]")!;
  const print = printer(box);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const num = new Intl.NumberFormat(lang);
  const date = new Intl.DateTimeFormat(lang, { dateStyle: "medium" });
  const UNLOCK_BLOCKS = 10;
  let shareLink = "";

  type Kind = "key" | "out" | "in";
  const kindOf = (secret: string): Kind | null => {
    const s = secret.replace(/\s+/g, "");
    if (s.startsWith("OutProof")) return "out";
    if (s.startsWith("InProof")) return "in";
    return parseTxKey(s) ? "key" : null;
  };

  const address = addressInput($("[data-address-input]"), () => showAddress());
  function showAddress() {
    const value = address.field.value.trim();
    const ok = !!value && parseAddress(value).ok;
    address.show(!value ? "" : ok ? "ok" : "");
    $("[data-address-ok]").hidden = !ok;
  }

  function showKind() {
    const kind = kindOf(field("secret").value);
    const badge = $("[data-kind]");
    badge.hidden = !kind;
    badge.querySelector("span")!.textContent = kind ? t(`v_chip_${kind}`) : "";
    $("[data-message-field]").hidden = kind !== "out" && kind !== "in";
  }

  function fieldError(name: string, key: string | null, vars?: Record<string, string>) {
    field(name).setAttribute("aria-invalid", String(!!key));
    if (name === "address") address.show(key ? "error" : "");
    $(`#${name}-message`).textContent = key ? t(key, vars) : "";
    return !!key;
  }

  /** Drives the printer: idle, checking, or a printed ok / fail receipt. */
  function show(state: "idle" | "checking" | "ok" | "fail") {
    root.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => (el.hidden = !el.dataset.show!.split(" ").includes(state)));
    $("[data-share]").hidden = state !== "ok";
    const stamp = $("[data-stamp]");
    stamp.dataset.tone = state === "ok" ? "ok" : "bad";
    stamp.textContent = t(state === "ok" ? "v_paid_t" : "v_fail_t");
    if (state === "idle") return print.set("idle");
    if (state === "checking") return print.set("working", t("v_checking"));
    print.set(state === "ok" ? "ok" : "bad", state === "ok" ? `✓ ${$("[data-subtitle]").textContent}` : t("v_fail_t"), { feed: true });
    if (box.getBoundingClientRect().bottom > innerHeight) box.scrollIntoView({ behavior: "smooth", block: "start" });
  }


  function fail(key: string, kind: Kind | null, vars?: Record<string, string>) {
    $("[data-via]").textContent = kind ? t("v_via", { kind: t(`v_chip_${kind}`) }) : "";
    $("[data-reason]").textContent = t(key, vars);
    show("fail");
  }

  let run = 0;
  async function check() {
    const txid = field("txid").value.trim().toLowerCase();
    const addr = address.field.value.trim();
    const secret = field("secret").value.replace(/\s+/g, "");
    const kind = kindOf(secret);
    const parsed = parseAddress(addr);
    const bad = [
      fieldError("txid", isTxid(txid) ? null : "v_err_txid"),
      fieldError("address", parsed.ok ? null : "v_err_address"),
      fieldError("secret", kind ? null : "v_err_secret"),
    ].some(Boolean);
    if (bad || !parsed.ok || !kind) return show("idle");
    if (parsed.network !== "mainnet" && !customNode()) return void fieldError("address", "v_err_network", { net: parsed.network });
    showAddress();

    const mine = ++run;
    $("[data-tx]").innerHTML = shortAddressHtml(txid);
    show("checking");
    let response: { txs?: { as_json: string; in_pool: boolean; block_height: number; block_timestamp: number }[] };
    let height: number;
    try {
      [response, { height }] = await Promise.all([
        call<typeof response>("/get_transactions", { txs_hashes: [txid], decode_as_json: true }),
        getInfo(),
      ]);
    } catch {
      if (mine === run) fail("live_error", kind);
      return;
    }
    if (mine !== run) return;
    const found = response.txs?.[0];
    if (!found) return fail("v_err_not_found", kind);
    const tx = txFromJson(found.as_json);
    if (!tx) return fail("v_err_bad-tx", kind);

    const message = field("message").value;
    const result: PaymentCheck = kind === "key"
      ? checkTxKey({ tx, txKey: secret, address: addr })
      : checkTxProof({ tx, txid, address: addr, message, signature: secret });
    if (!result.ok) return fail(`v_err_${result.error ?? "no-outputs"}`, kind);

    const confirmations = found.in_pool ? 0 : height - found.block_height;
    const left = Math.max(0, UNLOCK_BLOCKS - confirmations);
    $("[data-subtitle]").textContent = t(found.in_pool ? "v_pool_sub" : "v_paid_sub");
    $("[data-via]").textContent = t("v_via", { kind: t(`v_chip_${kind}`) });
    $("[data-amount]").textContent = picoToXmr(result.total.toString())!;
    $("[data-recipient]").innerHTML = shortAddressHtml(addr);
    $("[data-confirmations]").textContent = num.format(confirmations);
    $("[data-outputs]").textContent = num.format(result.outputs.length);
    $("[data-mined]").textContent = found.in_pool ? t("v_st_pending") : date.format(found.block_timestamp * 1000);
    $("[data-spendable]").innerHTML = left
      ? `<i class="size-2 bg-flame"></i>${t("v_st_in_blocks", { n: num.format(left) })}`
      : `<i class="size-2 bg-ok"></i><span class="text-ok">${t("v_st_yes")}</span>`;
    const share = new URLSearchParams({ tx: txid, address: addr, [kind === "key" ? "key" : "proof"]: secret, ...(message && kind !== "key" ? { message } : {}) });
    shareLink = `${location.origin}${location.pathname}#${share}`;
    show("ok");
  }

  field("secret").addEventListener("input", showKind);
  address.field.addEventListener("input", showAddress);
  $("[data-example]").addEventListener("click", () => {
    field("txid").value = EXAMPLE_PAYMENT.txid;
    address.set(EXAMPLE_PAYMENT.address);
    field("secret").value = EXAMPLE_PAYMENT.txKey;
    showAddress();
    showKind();
    check();
  });
  $("[data-where-toggle]").addEventListener("click", (e) => {
    const where = document.getElementById("where")!;
    where.hidden = !where.hidden;
    (e.currentTarget as HTMLElement).setAttribute("aria-expanded", String(!where.hidden));
  });
  $("[data-copy-check]").addEventListener("click", async () => {
    const label = $("[data-copy-check] span");
    try { await navigator.clipboard.writeText(shareLink); } catch { return; }
    label.textContent = t("copied");
    setTimeout(() => (label.textContent = t("v_share")), 1400);
  });
  form.addEventListener("submit", (e) => { e.preventDefault(); check(); });

  const shared = new URLSearchParams(location.hash.slice(1));
  if (shared.get("tx")) {
    field("txid").value = shared.get("tx") ?? "";
    address.set(shared.get("address") ?? "");
    field("secret").value = shared.get("key") ?? shared.get("proof") ?? "";
    field("message").value = shared.get("message") ?? "";
    showAddress();
    showKind();
  }
  // A shared link checks as soon as the page opens.
  liveTask(async () => { if (shared.get("tx")) await check(); });
</script>
