---
import NodeSource from "../live/NodeSource.astro";
import PixelIcon from "../PixelIcon.astro";
import Range from "../ui/Range.astro";
import { button, cx } from "../ui/styles";
import { FEE_TONES } from "./live-visuals";
import { localePath, pickStrings, useTranslations, type Locale } from "../../i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const FEE_LEGEND = [["lv_fee_low", FEE_TONES[0][0]], ["lv_fee_normal", FEE_TONES[1][0]], ["lv_fee_high", FEE_TONES[2][0]]] as const;
const strings = pickStrings(lang, ["lv_listen", "lv_stop", "lv_height", "lv_waiting", "lv_ago", "lv_new_block", "dur_s", "dur_min", "dur_h", "dur_d", "dur_y"]);
---
<div id="live-tool" class="grid grid-cols-1 gap-6" data-strings={strings} data-lang={lang} data-tx={localePath(lang, "/tx")}>
  <section data-stage class="grid gap-4 border-2 border-graphite bg-ink p-3 shadow-[8px_8px_0_var(--color-shade)] sm:p-4 [&:fullscreen]:flex [&:fullscreen]:flex-col [&:fullscreen]:items-center [&:fullscreen]:justify-center [&:fullscreen]:border-0 [&:fullscreen]:px-[3vw] [&:fullscreen]:py-[2vh] [&:fullscreen]:shadow-none [&:fullscreen>*]:w-[min(100%,calc(85vh*var(--ratio,1.6)))]">
    <div class="relative">
      <canvas data-viz class="block w-full [image-rendering:pixelated]"></canvas>
      <button type="button" data-start class="group absolute inset-0 grid cursor-pointer place-items-center bg-ink/55">
        <span class="flex flex-col items-center gap-3 font-pixel text-lg text-cream sm:text-xl">
          <span class="grid size-16 place-items-center bg-orange text-ink group-hover:bg-cream motion-safe:animate-beckon sm:size-20"><PixelIcon name="play" size={36} /></span>
          {t("lv_listen")}
        </span>
      </button>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <button type="button" data-listen class={button.primary}><PixelIcon name="sound" size={16} /><span>{t("lv_listen")}</span></button>
      <div class="grid gap-1 text-sm text-ash">
        <p>{t("lv_legend")}</p>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
          {FEE_LEGEND.map(([key, color]) => <span class="flex items-center gap-1.5"><span class="size-2.5" style={`background:${color}`}></span>{t(key)}</span>)}
        </p>
      </div>
      <div class="ml-auto flex items-center gap-3">
        <label class="flex items-center gap-2"><PixelIcon name="sound" size={16} class="text-orange" /><Range name="volume" label={t("bt_volume")} value={0.5} /></label>
        <button type="button" data-fullscreen class={cx(button.ghost, "px-3")} aria-label={t("bt_fullscreen")} title={t("bt_fullscreen")}><PixelIcon name="expand" size={16} /></button>
      </div>
    </div>
  </section>
  <div class="border-t-2 border-graphite pt-5"><NodeSource lang={lang} dark /></div>
</div>

<script>
  import { liveTask } from "../live/live";
  import { LiveMusic } from "./live-music";
  import { LiveVisuals } from "./live-visuals";
  import { readStrings } from "../../i18n/format";
  import type { Locale } from "../../i18n/ui";
  import { formatDuration } from "../../lib/duration";
  import { diffPool, feeTier, POLL_SECONDS, type FeeTier } from "../../lib/live";
  import { call, getFeeEstimate, getInfo } from "../../lib/node-client";

  const root = document.getElementById("live-tool")!;
  const t = readStrings(root);
  const lang = root.dataset.lang as Locale;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const canvas = $<HTMLCanvasElement>("[data-viz]");
  const volume = $<HTMLInputElement>("input[name=volume]");
  const num = new Intl.NumberFormat(lang);
  const visuals = new LiveVisuals(canvas, {
    height: (h) => t("lv_height", { height: num.format(h) }),
    waiting: (n) => t("lv_waiting", { n: num.format(n) }),
    ago: (s) => t("lv_ago", { time: formatDuration(s, t, lang) }),
    newBlock: t("lv_new_block"),
  });
  visuals.start();
  if (import.meta.env.DEV) Object.assign(window, { liveVisuals: visuals });

  let music: LiveMusic | undefined, pool = new Set<string>(), height = 0;

  function ensureMusic() {
    if (!music) { music = new LiveMusic(); music.synth.setVolume(Number(volume.value)); }
    return music;
  }

  /** Fee tier of each waiting transaction, from its fee per byte. Missing ones count as normal. */
  const tiers = new Map<string, FeeTier>();
  let estimates: number[] = [], estimatesAt = 0;
  async function lookUpFees(hashes: string[]) {
    if (!hashes.length) return;
    try {
      if (Date.now() - estimatesAt > 60_000) { estimates = (await getFeeEstimate()).fees ?? []; estimatesAt = Date.now(); }
      const r = await call<{ txs?: { tx_hash: string; as_hex: string; as_json: string }[] }>("/get_transactions", { txs_hashes: hashes.slice(0, 40), decode_as_json: true });
      for (const tx of r.txs ?? []) tiers.set(tx.tx_hash, feeTier(JSON.parse(tx.as_json).rct_signatures?.txnFee ?? 0, tx.as_hex.length / 2, estimates));
    } catch { /* colors and notes fall back to normal */ }
  }

  async function poll() {
    const [info, mempool] = await Promise.all([getInfo(), call<{ tx_hashes?: string[] }>("/get_transaction_pool_hashes", {})]);
    const hashes = mempool.tx_hashes ?? [];
    const first = height === 0;
    const { added, removed } = diffPool(pool, hashes);
    if (!first && info.height > height) {
      visuals.block(info.height - 1, removed);
      music?.block();
    }
    await lookUpFees(added);
    visuals.add(added, tiers, first);
    if (first) visuals.begin(info.height - 1);
    else for (const { hash, delay } of music?.transactions(added, tiers) ?? []) setTimeout(() => visuals.ring(hash), delay * 1000);
    for (const hash of removed) tiers.delete(hash);
    pool = new Set(hashes);
    height = info.height;
  }

  liveTask(async () => {
    await poll();
    setInterval(() => poll().catch(() => {}), POLL_SECONDS * 1000);
  });

  function toggleMusic() {
    const m = ensureMusic();
    if (m.playing) m.stop(); else m.start(Number(volume.value));
    $("[data-listen] span").textContent = t(m.playing ? "lv_stop" : "lv_listen");
    $("[data-start]").hidden = true;
  }
  $("[data-listen]").addEventListener("click", toggleMusic);
  $("[data-start]").addEventListener("click", toggleMusic);

  /** Hovering a transaction plays it; browsers only allow sound once the visitor has interacted with the page. */
  let hovered: string | undefined, armed: string | undefined;
  const touch = (hash: string) => { visuals.poke(hash); ensureMusic().hover(hash, tiers.get(hash)); };
  const open = (hash: string) => window.open(`${root.dataset.tx}#${hash}`, "_blank", "noopener");
  canvas.addEventListener("pointermove", (e) => {
    if (e.pointerType === "touch") return;
    const hash = visuals.hit(e.clientX, e.clientY);
    canvas.style.cursor = hash ? "pointer" : "";
    if (hash === hovered) return;
    hovered = hash;
    if (!hash) visuals.poke(undefined);
    else if (navigator.userActivation?.hasBeenActive ?? true) touch(hash);
    else visuals.poke(hash);
  });
  canvas.addEventListener("pointerleave", () => { hovered = undefined; visuals.leave(); });
  canvas.addEventListener("pointerdown", (e) => {
    const hash = visuals.hit(e.clientX, e.clientY);
    if (!hash) return;
    if (e.pointerType !== "touch" || hash === armed) { open(hash); return; }
    armed = hash;
    touch(hash);
  });

  volume.addEventListener("input", () => music?.synth.setVolume(Number(volume.value)));
  $("[data-fullscreen]").addEventListener("click", () => (document.fullscreenElement ? document.exitFullscreen() : $("[data-stage]").requestFullscreen()));
</script>
