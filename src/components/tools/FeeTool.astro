---
import CurrencySelect from "../live/CurrencySelect.astro";
import NodeSource from "../live/NodeSource.astro";
import Stepper from "../ui/Stepper.astro";
import TrustNote from "../ui/TrustNote.astro";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { PRIORITIES } from "../../lib/fees";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, ["fee_next_block", "fee_blocks", "fee_size", "fee_pool", "fee_all_next"]);
/** "Low (default)" reads as just "Low": the card already carries a default badge. */
const priorityName = (p: string) => t(`fee_${p}` as never).replace(/\s*[(（].*[)）]\s*$/, "");
---
<div id="fee-tool" class="grid grid-cols-1 gap-8" data-strings={strings} data-lang={lang}>
  <section class="grid gap-1.5">
      <h2 class="font-pixel text-sm tracking-[0.2em] text-cream uppercase">{t("fee_typical")}</h2>
      <p class="flex flex-wrap items-baseline gap-x-4">
        <span data-typical-xmr class="font-pixel text-[clamp(2rem,5vw,3rem)] leading-none text-orange">…</span>
        <span class="flex items-center gap-2"><span data-typical-fiat class="font-pixel text-xl text-cream"></span><CurrencySelect lang={lang} dark /></span>
      </p>
      <p class="max-w-[60ch] text-sm text-ash">{t("fee_typical_note")}</p>
  </section>

  <section class="grid gap-4" aria-labelledby="fee-shape-t">
    <h2 id="fee-shape-t" class="flex items-center gap-2.5 border-b-2 border-line pb-3 font-pixel text-sm tracking-[0.2em] text-cream uppercase"><span class="size-2 bg-orange"></span>{t("fee_by_priority")}</h2>
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <form data-shape class="flex flex-wrap items-end gap-3" novalidate>
        <Stepper name="inputs" label={t("fee_inputs")} value={1} min={1} max={16} />
        <Stepper name="recipients" label={t("fee_recipients")} value={1} min={1} max={15} />
        <p data-size class="pb-2.5 font-mono text-sm text-ash"></p>
      </form>
      <p data-same-wait class="flex items-center gap-2 pb-2.5 text-sm text-cream" hidden></p>
    </div>
    <ul class="mt-2 grid grid-cols-1 gap-x-3 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
      {PRIORITIES.map((p, i) => (
        <li data-priority={p} class:list={["relative grid content-start gap-2 border-2 bg-ink px-4 py-4", i === 0 ? "border-orange" : "border-graphite"]}>
          {i === 0 && <span class="absolute -top-3 left-3 bg-orange px-2 py-0.5 font-pixel text-xs text-ink uppercase">{t("fee_default")}</span>}
          <span class="font-pixel text-sm tracking-[0.12em] text-ash uppercase">{priorityName(p)}</span>
          <span data-xmr class="font-mono text-lg text-cream">…</span>
          <span data-fiat class="text-sm text-ash"></span>
          <span data-wait class="mt-1 flex items-center gap-2 text-sm text-cream empty:hidden"></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="grid gap-3 border-l-4 border-orange bg-ink px-5 py-5 sm:px-6" aria-labelledby="fee-pool-t">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="fee-pool-t" class="font-pixel text-lg text-orange">{t("fee_pool_t")}</h2>
    </div>
    <div class="grid gap-1" aria-hidden="true">
      <div class="relative h-4 bg-graphite">
        <span data-pool-bar class="block h-full w-0 bg-orange"></span>
        <i class="absolute top-0 left-1/2 h-full w-0.5 bg-ink"></i>
      </div>
      <div class="relative h-4 font-pixel text-xs text-ash"><span class="absolute left-1/2 -translate-x-1/2">{t("fee_one_block")}</span></div>
    </div>
    <p data-pool class="text-sm text-ash">…</p>
  </section>

  <div class="grid gap-3 border-t-2 border-graphite pt-5">
    <TrustNote icon="info">{t("fee_why")}</TrustNote>
    <NodeSource lang={lang} prices dark />
  </div>
</div>

<script>
  import { liveTask } from "../live/live";
  import { currencyPicker } from "../live/currency";
  import { readStrings } from "../../i18n/format";
  import type { Locale } from "../../i18n/ui";
  import { formatMoney, formatNumber } from "../../lib/currency";
  import { PRIORITIES, blocksToClear, estimateTxWeight, feeFor } from "../../lib/fees";
  import { call, getFeeEstimate, getInfo } from "../../lib/node-client";
  import { BLOCK_SECONDS, PICO_PER_XMR, type FeeEstimate, type NodeInfo } from "../../lib/nodes";
  import { getPrices, type Prices } from "../../lib/price-client";

  const root = document.getElementById("fee-tool")!;
  const t = readStrings(root);
  const lang = root.dataset.lang as Locale;
  const shape = root.querySelector<HTMLFormElement>("[data-shape]")!;
  const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
  const currency = currencyPicker(lang, render);
  const kb = (bytes: number) => formatNumber(bytes / 1000, lang, 1);
  // Fixed decimals so the priority fees line up and compare at a glance.
  const xmrFee = new Intl.NumberFormat(lang, { minimumFractionDigits: 6, maximumFractionDigits: 6 });
  const xmr = (pico: number) => `${xmrFee.format(pico / PICO_PER_XMR)} XMR`;

  let estimate: FeeEstimate | undefined, info: NodeInfo | undefined, poolBytes = 0, prices: Prices | undefined;

  const count = (name: string, min: number, max: number) => {
    const n = Math.round(Number((shape.elements.namedItem(name) as HTMLInputElement).value));
    return Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : min;
  };
  const fiat = (pico: number) => (prices ? `≈ ${formatMoney((pico / PICO_PER_XMR) * prices[currency()], currency(), lang)}` : "");

  function render() {
    if (!estimate || !info) return;
    const rates = estimate.fees?.length ? estimate.fees : [estimate.fee];
    const typical = feeFor(estimateTxWeight(1, 2), rates[0], estimate.quantization_mask);
    $("[data-typical-xmr]").textContent = xmr(typical);
    $("[data-typical-fiat]").textContent = fiat(typical);

    const weight = estimateTxWeight(count("inputs", 1, 16), count("recipients", 1, 15) + 1);
    const queue = blocksToClear(poolBytes, info.block_weight_median);
    // When every priority confirms in the next block, say it once instead of on every card.
    const sameWait = queue <= 1;
    $("[data-same-wait]").hidden = !sameWait;
    $("[data-same-wait]").innerHTML = `<i class="size-2 bg-good"></i>${t("fee_all_next")}`;
    PRIORITIES.forEach((p, i) => {
      const row = $(`[data-priority=${p}]`);
      row.hidden = rates[i] === undefined;
      if (row.hidden) return;
      const fee = feeFor(weight, rates[i], estimate!.quantization_mask);
      row.querySelector("[data-xmr]")!.textContent = xmr(fee);
      row.querySelector("[data-fiat]")!.textContent = fiat(fee);
      const blocks = i === 0 ? queue : 1;
      row.querySelector("[data-wait]")!.innerHTML = sameWait ? "" : `<i class="size-2 shrink-0 ${blocks === 1 ? "bg-good" : "bg-flame"}"></i>${blocks === 1
        ? t("fee_next_block")
        : t("fee_blocks", { n: blocks, min: Math.round((blocks * BLOCK_SECONDS) / 60) })}`;
    });
    $("[data-size]").textContent = t("fee_size", { kb: kb(weight) });
    $("[data-pool]").textContent = t("fee_pool", { txs: info.tx_pool_size, kb: kb(poolBytes), cap: kb(info.block_weight_median) });
    // The bar spans two blocks; the mark in the middle is one full block.
    $("[data-pool-bar]").style.width = `${Math.min(100, (poolBytes / (info.block_weight_median * 2)) * 100)}%`;
  }

  shape.addEventListener("input", render);
  shape.addEventListener("submit", (e) => e.preventDefault());

  liveTask(async () => {
    const [e, i, pool] = await Promise.all([
      getFeeEstimate(),
      getInfo(),
      call<{ pool_stats?: { bytes_total: number } }>("/get_transaction_pool_stats", {}),
    ]);
    estimate = e; info = i; poolBytes = pool.pool_stats?.bytes_total ?? 0;
    render();
  });
  getPrices().then((p) => { prices = p; render(); }).catch(() => {});
</script>
