---
import PixelIcon from "../PixelIcon.astro";
import AddressInput from "../ui/AddressInput.astro";
import Button from "../ui/Button.astro";
import Disclosure from "../ui/Disclosure.astro";
import QrCode from "../ui/QrCode.astro";
import Slip from "../ui/Slip.astro";
import TrustNote from "../ui/TrustNote.astro";
import { button, chip, code, field, fieldLabel, label, link, message, tone } from "../ui/styles";
import { localePath, pickStrings, useTranslations, type Locale } from "../../i18n/ui";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "a_type_standard", "a_type_subaddress", "a_type_integrated", "a_pid_bad", "a_chars", "a_same", "a_diff", "a_alias_l",
  "a_oa_looking", "a_oa_none", "a_oa_error", "a_oa_unsigned", "a_oa_invalid", "a_dnssec_ok", "a_dnssec_no", "a_chip_alias", "a_chip_address",
  "err_chars", "err_length", "err_checksum", "err_prefix", "warn_network", "qr_alt", "type_standard", "type_subaddress", "type_integrated", "copied",
]);
const heading = "font-pixel text-sm tracking-[0.2em] text-cream uppercase";
const keyRow = "grid gap-1 border-b-2 border-dotted border-graphite py-2.5 last:border-0 sm:grid-cols-[150px_1fr] sm:gap-4";
const keyValue = "break-all font-mono text-[13px] text-cream";
const copyChip = `${chip} ${tone.neutral} cursor-pointer hover:text-orange`;
const chevron = "M0 0h1v1H0zM1 1h1v1H1zM2 2h1v1H2zM1 3h1v1H1zM0 4h1v1H0z";
---
<div id="address-tool" class="grid grid-cols-1 gap-8" data-strings={strings} data-uri={localePath(lang, "/uri")}>
  <section class="grid grid-cols-1 gap-3">
    <div class="flex items-baseline justify-between gap-4">
      <label for="a-q" class={heading}>{t("a_input")}</label>
      <button type="button" data-example class={link}>{t("try_example")}</button>
    </div>
    <AddressInput id="a-q" name="q" placeholder={t("a_placeholder")} paste={t("pl_paste")} describedby="a-status" autofocus>
      <span data-chip class:list={[chip, tone.accent, "absolute bottom-2 left-3 sm:top-3 sm:right-3 sm:bottom-auto sm:left-auto"]} hidden></span>
    </AddressInput>
    <p id="a-status" class={message} aria-live="polite"></p>

    <div data-oa class="grid gap-2" hidden>
      <div data-oa-bar class="flex flex-wrap items-center gap-x-3 gap-y-2 border-l-4 border-graphite bg-ink px-5 py-3 text-[13px]">
        <span data-oa-name class="font-mono break-all text-cream"></span>
        <span data-oa-chain class="contents" hidden>
          <svg viewBox="0 0 3 5" width="6" height="10" class="text-slip-ink" aria-hidden="true" shape-rendering="crispEdges"><path d={chevron} fill="currentColor" /></svg>
          <span data-oa-domain class="font-mono break-all text-ash"></span>
          <svg viewBox="0 0 3 5" width="6" height="10" class="text-slip-ink" aria-hidden="true" shape-rendering="crispEdges"><path d={chevron} fill="currentColor" /></svg>
          <span data-oa-recipient class="font-semibold text-cream"></span>
        </span>
        <span data-oa-message class="text-ash"></span>
        <span data-oa-seal class:list={[chip, "ml-auto"]} hidden></span>
      </div>
      <p data-oa-warning class="text-sm text-bad" hidden>{t("a_oa_unsigned")}</p>
    </div>
  </section>

  <section data-card class="grid grid-cols-1 gap-5" hidden>
    <Slip dither>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_220px]">
        <div class="grid min-w-0 content-start gap-4">
          <div class="flex flex-wrap items-center gap-x-3.5 gap-y-3 border-b-2 border-slip-tile pb-4">
            <span class="pixel-corners grid size-10 shrink-0 place-items-center bg-ok text-paper"><PixelIcon name="check" size={24} class="block" /></span>
            <div class="grid min-w-0 flex-1 gap-0.5">
              <b class="font-pixel text-xl font-normal tracking-[0.12em] text-ok uppercase">{t("a_valid_t")}</b>
              <span class="text-[13px] text-graphite">{t("a_valid_sub")}</span>
            </div>
            <div class="flex shrink-0 gap-2 max-sm:basis-full">
              <span data-network class="border-2 border-ink px-2 py-0.5 font-pixel text-[10px] tracking-wider uppercase"></span>
              <span data-type-badge class="bg-ink px-2.5 py-1 font-pixel text-[10px] tracking-wider text-orange uppercase"></span>
            </div>
          </div>
          <p data-chars class:list={[label, "text-[10px]"]}></p>
          <div data-chunks class="grid grid-cols-4 gap-1.5 font-mono text-[15px] sm:grid-cols-6 xl:grid-cols-8"></div>
          <p data-type class="text-[13px] text-graphite"></p>
        </div>
        <QrCode brackets={t("a_scan")} data-qr-box class="mx-auto w-full max-w-[220px] self-start" />
      </div>
      <Fragment slot="footer">
        <span data-footer-label class={label}></span>
        <span data-footer class="min-w-0 truncate font-mono text-[13px]"></span>
        <span class="ml-auto font-pixel text-[11px] text-slip-ink">xmr.fan</span>
      </Fragment>
    </Slip>

    <div class="flex flex-wrap gap-3">
      <Button data-copy-from="[data-address-full]"><PixelIcon name="copy" size={16} /><span>{t("a_copy_address")}</span></Button>
      <a data-pay class={button.ghost}>
        <PixelIcon name="qr" size={16} class="text-orange" />{t("a_pay_link")}
        <svg viewBox="0 0 3 5" width="6" height="10" class="text-slip-ink" aria-hidden="true" shape-rendering="crispEdges"><path d={chevron} fill="currentColor" /></svg>
      </a>
      <span data-address-full hidden></span>
    </div>

    <div class="grid grid-cols-1 items-start gap-3 lg:grid-cols-2">
      <Disclosure title={t("a_details")} hint={t("a_keys_hint")}>
        <dl>
          <div class={keyRow}><dt class={fieldLabel}>{t("a_spend")}</dt><dd data-spend class={keyValue}></dd></div>
          <div class={keyRow}><dt class={fieldLabel}>{t("a_view")}</dt><dd data-view class={keyValue}></dd></div>
          <div class={keyRow} data-pid-row hidden><dt class={fieldLabel}>{t("a_pid")}</dt><dd data-pid class={keyValue}></dd></div>
          <div class={keyRow} data-inner-row hidden><dt class={fieldLabel}>{t("a_inner")}</dt><dd data-inner class={keyValue}></dd></div>
        </dl>
        <p class="text-xs text-slip-ink">{t("a_keys_note")}</p>
      </Disclosure>
      <Disclosure title={t("a_compare_t")} hint={t("a_compare_hint")}>
        <p class="text-sm text-ash">{t("a_compare_help")}</p>
        <textarea name="other" rows="2" spellcheck="false" autocomplete="off" autocapitalize="off" class:list={[field, "min-h-14 resize-y font-mono text-[13px] break-all"]} aria-label={t("a_compare_t")}></textarea>
        <div data-compare-result class="grid gap-2" hidden>
          <p data-compare-verdict class="font-pixel"></p>
          <p data-compare-a class="font-mono text-[13px] leading-relaxed break-all text-cream"></p>
          <p data-compare-b class="font-mono text-[13px] leading-relaxed break-all text-cream"></p>
        </div>
      </Disclosure>
      <Disclosure title={t("a_integrate_t")} hint={t("a_integrate_hint")} data-integrate class="lg:col-span-2" hidden>
        <p class="text-sm text-ash">{t("a_integrate_help")}</p>
        <label for="a-pid" class={fieldLabel}>{t("a_pid_input")}</label>
        <div class="flex flex-wrap gap-2">
          <input id="a-pid" name="pid" maxlength="16" spellcheck="false" autocomplete="off" class:list={[field, "min-w-0 flex-1 basis-64 font-mono"]} aria-describedby="pid-message" />
          <Button variant="ghost" data-random>{t("a_random")}</Button>
        </div>
        <p id="pid-message" class={message}></p>
        <div data-integrated-box class="grid gap-2" hidden>
          <output id="integrated" class={code}></output>
          <button type="button" data-copy-from="#integrated" class:list={[copyChip, "justify-self-start"]}><PixelIcon name="copy" size={10} class="text-orange" /><span>{t("share_copy")}</span></button>
        </div>
      </Disclosure>
    </div>
  </section>

  <TrustNote class="border-t-2 border-graphite pt-5">{t("a_privacy")}</TrustNote>

  <section data-oa-tool class="grid grid-cols-1 gap-6 border-l-4 border-orange bg-ink px-5 py-6 sm:px-7" aria-labelledby="oa-make">
    <div class="grid gap-1.5">
      <h2 id="oa-make" class="font-pixel text-xl text-orange">{t("a_oa_make_t")}</h2>
      <p class="max-w-[70ch] text-[15px] text-ash">{t("a_oa_make_help")}</p>
    </div>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_400px]">
      <div class="grid content-start gap-4">
        <div class="grid gap-2">
          <label for="oa-address" class={heading}>{t("a_oa_addr")}</label>
          <AddressInput id="oa-address" name="oa-address" />
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid content-start gap-2">
            <label for="oa-host" class={heading}>{t("a_oa_host")}</label>
            <input id="oa-host" name="oa-host" placeholder="donate@example.com" autocomplete="off" spellcheck="false" class:list={[field, "font-mono text-[14px]"]} />
          </div>
          <div class="grid content-start gap-2">
            <label for="oa-name" class="flex items-baseline justify-between gap-2"><span class={heading}>{t("a_shown")}</span><span class="text-xs text-slip-ink">{t("pl_optional")}</span></label>
            <input id="oa-name" name="oa-name" maxlength="60" placeholder="Example Shop" autocomplete="off" class={field} />
          </div>
        </div>
      </div>
      <div class="grid content-start gap-2">
        <span class={heading}>{t("a_record")}</span>
        <div class="relative grid gap-3 border-l-4 border-orange bg-well px-5 py-4">
          <p data-record-wait class="text-sm text-slip-ink">{t("a_record_wait")}</p>
          <dl data-record class="grid grid-cols-[52px_1fr] items-baseline gap-x-3 gap-y-2.5 pr-16" hidden>
            <dt class:list={[label, "text-[10px]"]}>{t("a_rec_type")}</dt><dd class="font-mono text-[13px] text-good">TXT</dd>
            <dt class:list={[label, "text-[10px]"]}>{t("a_rec_host")}</dt><dd data-record-host class="font-mono text-[13px] break-all text-cream"></dd>
            <dt class:list={[label, "text-[10px]"]}>{t("a_rec_value")}</dt><dd data-record-value class="font-mono text-[13px] leading-relaxed break-all text-cream"></dd>
          </dl>
          <span id="oa-record" hidden></span>
          <button type="button" data-copy-from="#oa-record" data-record-copy class:list={[copyChip, "absolute top-3 right-3"]} hidden><PixelIcon name="copy" size={10} class="text-orange" /><span>{t("share_copy")}</span></button>
        </div>
      </div>
    </div>
    <ol class="flex flex-wrap items-center gap-x-5 gap-y-3 bg-ink-2 px-4 py-3 text-[14px] text-cream">
      {[t("a_step_add"), t("a_step_dnssec"), t("a_step_test")].map((step, i) => (
        <li class="flex items-center gap-2.5">
          <span class="grid size-5 place-items-center bg-orange font-pixel text-xs text-ink">{i + 1}</span>{step}
        </li>
      ))}
      <li class="ml-auto"><button type="button" data-oa-test class="flex cursor-pointer items-center gap-2 font-pixel text-orange disabled:cursor-not-allowed disabled:opacity-40" disabled>{t("a_test_now")}<svg viewBox="0 0 3 5" width="6" height="10" aria-hidden="true" shape-rendering="crispEdges"><path d={chevron} fill="currentColor" /></svg></button></li>
    </ol>
  </section>
</div>

<script>
  import { addressInput, shortAddressHtml } from "../ui/address-input";
  import { bindCopyButtons } from "../ui/copy";
  import { qrBox } from "../ui/qr";
  import { tone } from "../ui/styles";
  import { readStrings } from "../../i18n/format";
  import { differences, integratedAddress, openAliasDomain, openAliasRecord, randomPaymentId, resolveOpenAlias, splitIntegrated } from "../../lib/address";
  import { EXAMPLE_OPENALIAS } from "../../lib/examples";
  import { buildUri, parseAddress } from "../../lib/monero";

  const root = document.getElementById("address-tool")!;
  const t = readStrings(root);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const [mainBox, oaBox] = root.querySelectorAll<HTMLElement>("[data-address-input]");
  const query = addressInput(mainBox, () => render());
  const oaAddress = addressInput(oaBox, () => renderRecord());
  const pid = $<HTMLInputElement>("input[name=pid]");
  const status = $("#a-status");
  const showQr = qrBox($("[data-qr-box]"));
  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  let current = "";
  let alias: { typed: string; name?: string } | undefined;

  /** False if the address is invalid. */
  function showAddress(address: string): boolean {
    const parsed = parseAddress(address);
    $("[data-card]").hidden = !parsed.ok;
    if (!parsed.ok) return false;
    current = address.trim();
    $("[data-network]").textContent = parsed.network;
    $("[data-type-badge]").textContent = t(`type_${parsed.type}`);
    $("[data-chars]").textContent = t("a_chars", { n: current.length });
    // Groups of four, the first and last marked: those are what people compare.
    const groups = current.match(/.{1,4}/g)!;
    $("[data-chunks]").replaceChildren(...groups.map((g, i) => {
      const cell = document.createElement("span");
      const end = i === 0 || i === groups.length - 1;
      cell.textContent = g;
      cell.className = `py-1.5 text-center ${end ? "bg-[#ffe3cc] font-bold text-flame" : "bg-slip-tile"}`;
      return cell;
    }));
    $("[data-type]").textContent = t(`a_type_${parsed.type}`);
    $("[data-address-full]").textContent = current;
    showQr(buildUri({ address: current, name: alias?.name }), t("qr_alt"));
    $("[data-footer-label]").textContent = alias ? t("a_alias_l") : "XMR";
    $("[data-footer]").innerHTML = alias ? `${escape(alias.typed)}${alias.name ? ` <span class="font-sans text-slip-ink">· ${escape(alias.name)}</span>` : ""}` : shortAddressHtml(current);
    $("[data-spend]").textContent = parsed.publicSpendKey;
    $("[data-view]").textContent = parsed.publicViewKey;
    $("[data-pid-row]").hidden = !parsed.paymentId;
    $("[data-pid]").textContent = parsed.paymentId ?? "";
    const inner = splitIntegrated(current);
    $("[data-inner-row]").hidden = !inner;
    $("[data-inner]").textContent = inner?.standard ?? "";
    $<HTMLAnchorElement>("[data-pay]").href = `${root.dataset.uri}?address=${current}${alias?.name ? `&recipient_name=${encodeURIComponent(alias.name)}` : ""}`;
    $("[data-integrate]").hidden = parsed.type !== "standard";
    renderIntegrated();
    renderCompare();
    if (!oaAddress.field.value) { oaAddress.set(current); renderRecord(); }
    if (parsed.network !== "mainnet") setStatus(t("warn_network", { net: parsed.network }));
    return true;
  }

  function setStatus(text: string) { status.textContent = text; }

  function setChip(kind: "alias" | "address" | null) {
    const el = $("[data-chip]");
    el.hidden = !kind;
    el.textContent = kind ? t(`a_chip_${kind}`) : "";
  }

  function renderIntegrated() {
    const value = pid.value.trim();
    const r = value ? integratedAddress(current, value) : null;
    const bad = !!r && !r.ok;
    pid.setAttribute("aria-invalid", String(bad));
    $("#pid-message").textContent = bad ? t("a_pid_bad") : "";
    $("[data-integrated-box]").hidden = !r?.ok;
    $("#integrated").textContent = r?.ok ? r.address : "";
  }

  /** Built with text nodes only: the input is untrusted. */
  function renderCompare() {
    const other = $<HTMLTextAreaElement>("textarea[name=other]").value.trim();
    $("[data-compare-result]").hidden = !other;
    if (!other) return;
    const diff = differences(current, other);
    const verdict = $("[data-compare-verdict]");
    verdict.textContent = diff.size ? `× ${t("a_diff", { n: diff.size })}` : `✓ ${t("a_same")}`;
    verdict.className = `font-pixel ${diff.size ? "text-bad" : "text-good"}`;
    const marked = (text: string) => [...text].map((ch, i) => {
      if (!diff.has(i)) return document.createTextNode(ch);
      const mark = document.createElement("mark");
      mark.className = "bg-bad text-ink";
      mark.textContent = ch;
      return mark;
    });
    $("[data-compare-a]").replaceChildren(...marked(current));
    $("[data-compare-b]").replaceChildren(...marked(other));
  }

  function renderRecord() {
    const address = oaAddress.field.value.trim();
    const host = openAliasDomain($<HTMLInputElement>("input[name=oa-host]").value);
    const valid = parseAddress(address).ok;
    oaAddress.show(address ? (valid ? "ok" : "error") : "");
    const ready = valid && !!host;
    $("[data-record]").hidden = $("[data-record-copy]").hidden = !ready;
    $("[data-record-wait]").hidden = ready;
    $<HTMLButtonElement>("[data-oa-test]").disabled = !host;
    if (!ready) return;
    const record = openAliasRecord(address, $<HTMLInputElement>("input[name=oa-name]").value);
    $("#oa-record").textContent = record;
    $("[data-record-host]").textContent = host!;
    // oa1:xmr key=value; key=value;
    $("[data-record-value]").innerHTML = escape(record)
      .replace(/(\w+)=/g, '<span class="text-slip-ink">$1=</span>')
      .replace(/^oa1:xmr/, '<span class="text-orange">oa1:xmr</span>');
  }

  let lookup = 0;
  async function showAlias(domain: string, typed: string) {
    const run = ++lookup;
    const box = $("[data-oa]"), msg = $("[data-oa-message]"), seal = $("[data-oa-seal]"), bar = $("[data-oa-bar]");
    box.hidden = false;
    $("[data-oa-name]").textContent = typed;
    $("[data-oa-chain]").hidden = seal.hidden = $("[data-oa-warning]").hidden = true;
    bar.classList.remove("border-good", "border-bad");
    msg.textContent = t("a_oa_looking", { name: domain });
    try {
      const { aliases, dnssec } = await resolveOpenAlias(domain);
      if (run !== lookup) return;
      const found = aliases[0];
      if (!found) { msg.textContent = t("a_oa_none", { name: domain }); bar.classList.add("border-bad"); return; }
      if (!found.valid) { msg.textContent = t("a_oa_invalid"); bar.classList.add("border-bad"); return; }
      msg.textContent = "";
      $("[data-oa-chain]").hidden = false;
      $("[data-oa-domain]").textContent = domain;
      $("[data-oa-recipient]").textContent = found.name ?? "";
      seal.hidden = false;
      seal.textContent = t(dnssec ? "a_dnssec_ok" : "a_dnssec_no");
      seal.classList.remove(...tone.good.split(" "), ...tone.bad.split(" "));
      seal.classList.add(...(dnssec ? tone.good : tone.bad).split(" "));
      $("[data-oa-warning]").hidden = dnssec;
      bar.classList.add(dnssec ? "border-good" : "border-bad");
      alias = { typed, name: found.name };
      showAddress(found.address);
    } catch {
      if (run === lookup) { msg.textContent = t("a_oa_error", { name: domain }); bar.classList.add("border-bad"); }
    }
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  function render() {
    clearTimeout(timer);
    lookup++;
    alias = undefined;
    setStatus("");
    $("[data-oa]").hidden = true;
    const value = query.field.value.trim();
    query.field.setAttribute("aria-invalid", "false");
    if (!value) { setChip(null); query.show(""); showAddress(""); return; }
    if (showAddress(value)) { setChip("address"); query.show("ok"); return; }
    query.show("");
    const domain = openAliasDomain(value);
    if (domain) { setChip("alias"); timer = setTimeout(() => showAlias(domain, value), 500); return; }
    setChip(null);
    const parsed = parseAddress(value);
    if (!parsed.ok) {
      query.field.setAttribute("aria-invalid", "true");
      query.show("error");
      setStatus(t(`err_${parsed.error}`, { n: value.length }));
    }
  }

  query.field.addEventListener("input", render);
  $("[data-example]").addEventListener("click", () => { query.set(EXAMPLE_OPENALIAS); render(); });
  pid.addEventListener("input", renderIntegrated);
  $("textarea[name=other]").addEventListener("input", renderCompare);
  oaAddress.field.addEventListener("input", renderRecord);
  for (const name of ["oa-host", "oa-name"]) $(`input[name=${name}]`).addEventListener("input", renderRecord);
  $("[data-oa-test]").addEventListener("click", () => {
    query.set($<HTMLInputElement>("input[name=oa-host]").value.trim());
    render();
    query.field.scrollIntoView({ block: "center" });
  });
  $("[data-random]").addEventListener("click", () => { pid.value = randomPaymentId(); renderIntegrated(); });
  bindCopyButtons(root, t("copied"));

  const prefill = new URLSearchParams(location.search).get("address");
  if (prefill) query.set(prefill);
  render();
</script>
