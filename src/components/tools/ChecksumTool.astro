---
import PixelIcon from "../PixelIcon.astro";
import Corners from "../ui/Corners.astro";
import Printer from "../ui/Printer.astro";
import Receipt from "../ui/Receipt.astro";
import Stamp from "../ui/Stamp.astro";
import TrustNote from "../ui/TrustNote.astro";
import StatTile from "../ui/StatTile.astro";
import Step from "../ui/Step.astro";
import { cx, field, label, link } from "../ui/styles";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { DOWNLOADS_PAGE, VERIFY_GUIDE } from "../../lib/hashes";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "c_hashing", "c_mismatch_detail", "c_unknown_detail", "c_list_error", "c_matches", "c_no_match", "c_genuine_t", "c_genuine_sub", "c_mismatch_t", "c_mismatch", "c_unknown_t", "c_unknown",
  "c_kind_gui", "c_kind_cli", "c_kind_source", "c_latest", "c_match_badge", "c_differs", "c_signed", "c_count", "c_show_more", "c_installer", "c_trust", "c_download", "copied", "share_copy", "c_unknown_t", "c_mismatch_t",
]);
const FILTERS = [{ value: "all", name: t("c_all") }, { value: "gui", name: "GUI" }, { value: "cli", name: "CLI" }, { value: "source", name: t("c_kind_source") }];
---
<div id="checksum-tool" class="grid grid-cols-1 gap-8" data-strings={strings} data-lang={lang}>
  <div class="grid grid-cols-1 items-stretch gap-x-6 gap-y-5 lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
    <section class="grid content-start gap-3">
      <Step n="01" label={t("c_step_drop")} />
      <label data-drop class="group/drop relative grid h-full min-h-44 cursor-pointer place-items-center content-center gap-2 border-2 border-dashed border-line bg-ink px-6 py-8 text-center hover:border-orange [&.over]:border-solid [&.over]:border-orange [&.over]:bg-well">
        <Corners inset="10px" />
        <PixelIcon name="download" size={32} class="text-orange" />
        <span class="font-pixel text-[15px] text-cream">{t("c_drop_t")}</span>
        <span class="text-sm text-ash"><span class="text-orange underline underline-offset-3">{t("c_drop_or")}</span> · .exe .dmg .zip .tar.bz2</span>
        <input type="file" class="sr-only" />
      </label>
    </section>

    <div class="flex items-center gap-4 font-pixel text-[11px] tracking-[0.2em] text-slip-ink uppercase lg:flex-col lg:pt-9">
      <span class="h-0.5 flex-1 bg-graphite lg:h-auto lg:w-0.5"></span>{t("c_or")}<span class="h-0.5 flex-1 bg-graphite lg:h-auto lg:w-0.5"></span>
    </div>

    <section class="grid content-start gap-3">
      <Step as="label" for="c-hash" n="02" label={t("c_step_paste")} />
      <input id="c-hash" name="hash" spellcheck="false" autocomplete="off" maxlength="64" placeholder="44cd1489…" class={cx(field, "font-mono text-[13px]")} aria-describedby="c-hash-status" />
      <p id="c-hash-status" class="text-sm empty:hidden" aria-live="polite"></p>
      <TrustNote class="mt-1">{`${t("c_local_t")} ${t("c_local_sub")}`}</TrustNote>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ash">
        {t("c_get_t")}
        <a href={DOWNLOADS_PAGE} target="_blank" rel="noopener" class={cx(link, "inline-flex items-center gap-1.5")}>{t("c_get_link")}<PixelIcon name="external" size={10} /></a>
      </p>
    </section>
  </div>

  <Printer idle={t("c_printer_idle")} aria-live="polite">
    <Receipt>
      <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
        <div class="grid min-w-0 flex-1 basis-64 gap-1">
          <span class={cx(label, "text-[10px]")}>{t("c_file")}</span>
          <span data-file class="font-pixel text-lg leading-snug break-all sm:text-xl"></span>
          <span data-status-sub class="text-[14px] text-graphite"></span>
        </div>
        <Stamp data-stamp-text class="mt-1 mr-2 shrink-0"></Stamp>
      </div>
      <div data-show="genuine" class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <StatTile label={t("c_version")}><span data-version class="text-[15px]"></span></StatTile>
        <StatTile label={t("c_type")}><span data-kind class="text-[15px]"></span></StatTile>
        <StatTile label={t("c_platform")}><span data-platform class="text-[15px]"></span></StatTile>
        <StatTile label={t("c_release")}><span class="flex items-center gap-1.5 text-[15px] text-ok"><i class="size-2 bg-ok"></i>{t("c_latest")}</span></StatTile>
      </div>
      <p data-show="mismatch unknown" data-detail class="text-[15px] text-graphite"></p>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="grid content-start gap-1.5">
          <div class="flex items-center justify-between gap-3">
            <span class={cx(label, "text-[10px]")}>{t("c_your_hash")}</span>
            <span data-badge class="px-2 py-0.5 font-pixel text-[10px] tracking-wider text-paper uppercase"></span>
          </div>
          <p data-yours class="border-b-2 pb-1 font-mono text-[12px] leading-relaxed break-all"></p>
        </div>
        <div data-official-row class="grid content-start gap-1.5">
          <span class={cx(label, "text-[10px]")}>{t("c_official")}</span>
          <p data-official class="border-b-2 pb-1 font-mono text-[12px] leading-relaxed break-all"></p>
        </div>
      </div>
      <Fragment slot="footer">
        <svg viewBox="0 0 8 8" width="11" height="11" class="shrink-0 text-slip-ink" aria-hidden="true" shape-rendering="crispEdges"><path d="M0 2h4v4H0zM4 3h4v2H4zM6 5h1v2H6zM1 3v2h2V3z" fill="currentColor" fill-rule="evenodd" /></svg>
        <span data-signed class={cx(label, "min-w-0 truncate text-[10px]")}>…</span>
        <span class={cx(label, "ml-auto text-[10px]")}>{t("c_receipt")} · SHA-256 · xmr.fan</span>
      </Fragment>
    </Receipt>
  </Printer>

  <section data-list-box class="grid gap-4" aria-labelledby="c-list" hidden>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-b-2 border-line pb-3">
      <h2 id="c-list" class="flex items-center gap-2.5 font-pixel text-sm tracking-[0.2em] text-cream uppercase"><span class="size-2 bg-orange"></span>{t("c_official_t")}</h2>
      <span data-count class="text-sm text-slip-ink"></span>
      <a href={DOWNLOADS_PAGE} target="_blank" rel="noopener" class={cx(link, "inline-flex items-center gap-1.5")}>{t("c_get_link")}<PixelIcon name="external" size={10} /></a>
      <div class="flex w-full flex-wrap gap-2 sm:ml-auto sm:w-auto">
        <div class="flex bg-well p-0.5 font-pixel text-[11px] uppercase" role="radiogroup">
          {FILTERS.map((f) => (
            <label class="cursor-pointer px-3 py-1 text-slip-ink has-checked:bg-graphite has-checked:text-cream has-focus-visible:outline-2 has-focus-visible:outline-orange">
              <input type="radio" name="kind" value={f.value} checked={f.value === "all"} class="sr-only" />{f.name}
            </label>
          ))}
        </div>
        <input name="os" type="search" placeholder={t("c_filter")} autocomplete="off" class={cx(field, "w-40 flex-1 px-3 py-1 text-sm sm:flex-none")} />
      </div>
    </div>
    <div data-groups class="grid gap-5"></div>
  </section>

  <p data-trust class="flex flex-wrap items-start gap-x-4 gap-y-2 border-t-2 border-graphite pt-5 text-sm text-ash">
    <svg viewBox="0 0 8 8" width="14" height="14" class="mt-0.5 shrink-0 text-good" aria-hidden="true" shape-rendering="crispEdges"><path d="M0 2h4v4H0zM4 3h4v2H4zM6 5h1v2H6zM1 3v2h2V3z" fill="currentColor" fill-rule="evenodd" /></svg>
    <span data-trust-text class="min-w-64 flex-1 [overflow-wrap:anywhere]"></span>
    <a href={VERIFY_GUIDE} target="_blank" rel="noopener" class={cx(link, "inline-flex items-center gap-1.5")}>{t("c_verify_yourself")}<PixelIcon name="external" size={10} /></a>
  </p>
</div>

<script>
  import { sha256 } from "@noble/hashes/sha2.js";
  import { bindCopyButtons } from "../ui/copy";
  import { printer } from "../ui/printer";
  import { readStrings } from "../../i18n/format";
  import { describeFile, downloadUrl, matchHash, type HashEntry, type HashList } from "../../lib/hashes";

  const root = document.getElementById("checksum-tool")!;
  const t = readStrings(root);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const box = $("[data-printer]");
  const print = printer(box);
  const drop = $("[data-drop]"), fileInput = $<HTMLInputElement>("input[type=file]"), hashInput = $<HTMLInputElement>("input[name=hash]");
  const hex = (b: Uint8Array) => Array.from(b, (x) => x.toString(16).padStart(2, "0")).join("");
  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const HASH = /^[0-9a-fA-F]{64}$/;
  let matched: string | undefined;

  const listReady: Promise<HashList | null> = fetch("/api/hashes").then((r) => (r.ok ? r.json() : null)).catch(() => null);

  /** Parts of the receipt that only apply to some results. */
  function showParts(kind: "genuine" | "mismatch" | "unknown") {
    box.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => (el.hidden = !el.dataset.show!.split(" ").includes(kind)));
  }

  /** The hash in groups of eight; with `other`, groups that differ are marked. */
  const groups = (hash: string, other?: string) => hash.match(/.{8}/g)!.map((g, i) =>
    other && other.slice(i * 8, i * 8 + 8) !== g ? `<mark class="bg-danger px-0.5 text-paper">${g}</mark>` : g).join(" ");

  async function check(hash: string, fileName?: string) {
    const list = await listReady;
    if (!list) return;
    hash = hash.toLowerCase();
    const match = matchHash(hash, fileName, list.files);
    const entry = match.kind === "unknown" ? undefined : match.entry;
    const tone = ({ genuine: "ok", mismatch: "bad", unknown: "warn" } as const)[match.kind];
    const stamp = $("[data-stamp]");
    stamp.dataset.tone = tone;
    stamp.textContent = t(`c_${match.kind}_t`);
    $("[data-status-sub]").textContent = match.kind === "genuine" ? t("c_genuine_sub") : t(`c_${match.kind}`, { version: list.version });
    $("[data-file]").textContent = entry?.name ?? fileName ?? "–";
    const vars = { name: entry?.name ?? fileName ?? "", version: list.version };
    $("[data-detail]").textContent = match.kind === "genuine" ? "" : t(`c_${match.kind}_detail`, vars);
    if (entry) {
      const info = describeFile(entry.name);
      $("[data-version]").textContent = list.version;
      $("[data-kind]").textContent = t(`c_kind_${info.kind}`);
      $("[data-platform]").textContent = info.platform;
    }
    const ok = match.kind === "genuine";
    $("[data-yours]").innerHTML = groups(hash, entry?.sha256);
    $("[data-official]").innerHTML = entry ? groups(entry.sha256) : "";
    $("[data-official-row]").hidden = !entry;
    for (const el of [$("[data-yours]"), $("[data-official]")]) el.classList.toggle("border-ok", ok), el.classList.toggle("border-danger", !ok);
    const badge = $("[data-badge]");
    badge.textContent = ok ? t("c_match_badge") : t("c_differs");
    badge.className = badge.className.replace(/ bg-\S+$/, "") + (ok ? " bg-ok" : " bg-danger");
    $("#c-hash-status").textContent = ok ? `✓ ${t("c_matches")}` : `× ${t("c_no_match")}`;
    $("#c-hash-status").className = `text-sm ${ok ? "text-good" : "text-bad"}`;
    hashInput.dataset.state = ok ? "ok" : "error";
    matched = ok ? entry!.sha256 : undefined;
    renderList(list);
    showParts(match.kind);
    print.set(tone, ok ? `✓ ${t("c_matches")}` : t(`c_${match.kind}_t`));
    if (box.getBoundingClientRect().bottom > innerHeight) box.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function clear() {
    hashInput.dataset.state = "";
    $("#c-hash-status").textContent = "";
    matched = undefined;
    print.set("idle");
    listReady.then((list) => list && renderList(list));
  }

  /* ---------- the official list ---------- */
  let showAllCli = false;
  function row(f: HashEntry) {
    const info = describeFile(f.name), hit = f.sha256 === matched;
    return `<li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 border-l-4 px-3 py-2 sm:grid-cols-[110px_minmax(0,1fr)_auto_150px_auto] ${hit ? "border-good bg-[#1f3a2a]" : "border-transparent bg-ink"}">
      <span class="w-fit px-2 py-0.5 font-pixel text-[10px] tracking-wider uppercase max-sm:col-span-2 ${hit ? "bg-ok text-paper" : "bg-graphite text-cream"}">${escape(info.platform)}${info.installer ? ` · ${t("c_installer")}` : ""}</span>
      <a href="${downloadUrl(f.name)}" class="min-w-0 truncate font-mono text-[12px] ${hit ? "text-good" : "text-cream"} hover:text-orange hover:underline" title="${t("c_download")} ${escape(f.name)}">${escape(f.name)}</a>
      <span class="hidden font-pixel text-[10px] tracking-wider text-good uppercase sm:inline">${hit ? "✓" : ""}</span>
      <code class="hidden font-mono text-[12px] sm:block ${hit ? "text-good" : "text-ash"}">${f.sha256.slice(0, 8)}…${f.sha256.slice(-8)}</code>
      <button type="button" class="cursor-pointer p-1 ${hit ? "text-good" : "text-slip-ink"} hover:text-orange" data-copy-hash="${f.sha256}" aria-label="${t("share_copy")} SHA-256 ${escape(f.name)}"><svg viewBox="0 0 8 8" width="12" height="12" aria-hidden="true" shape-rendering="crispEdges"><path fill-rule="evenodd" d="M2 0h6v6H2zM3 1v4h4V1zM0 2h1v5h5v1H0z" fill="currentColor"/></svg></button>
    </li>`;
  }

  function renderList(list: HashList) {
    const kind = root.querySelector<HTMLInputElement>("input[name=kind]:checked")!.value;
    const query = $<HTMLInputElement>("input[name=os]").value.trim().toLowerCase();
    const files = list.files.filter((f) => {
      const info = describeFile(f.name);
      return (kind === "all" || info.kind === kind) && (!query || `${info.platform} ${f.name}`.toLowerCase().includes(query));
    });
    const gui = files.filter((f) => describeFile(f.name).kind === "gui");
    const rest = files.filter((f) => describeFile(f.name).kind !== "gui");
    const folded = kind === "all" && !query && !showAllCli && !rest.some((f) => f.sha256 === matched);
    const section = (title: string, items: HashEntry[], fold: boolean) => !items.length ? "" : `<div class="grid gap-1.5">
      <p class="font-pixel text-[10px] tracking-[0.18em] text-slip-ink uppercase">${title} · ${items.length}</p>
      ${fold
        ? `<button type="button" data-more class="flex cursor-pointer items-center gap-3 border-2 border-dashed border-line px-4 py-2.5 text-left hover:border-orange"><span class="font-pixel text-sm text-cream">› ${t("c_show_more", { n: items.length })}</span><span class="ml-auto hidden text-xs text-slip-ink sm:inline">${[...new Set(items.map((f) => describeFile(f.name).os))].join(" · ")}</span></button>`
        : `<ul class="grid gap-1">${items.map(row).join("")}</ul>`}
    </div>`;
    $("[data-groups]").innerHTML = section(t("c_kind_gui"), gui, false) + section(`CLI · ${t("c_kind_source")}`, rest, folded);
    $("[data-groups] [data-more]")?.addEventListener("click", () => { showAllCli = true; renderList(list); });
    $("[data-groups]").querySelectorAll<HTMLButtonElement>("[data-copy-hash]").forEach((b) => b.addEventListener("click", () => navigator.clipboard.writeText(b.dataset.copyHash!).catch(() => {})));
  }

  listReady.then((list) => {
    if (!list) { $("[data-trust-text]").textContent = t("c_list_error"); return; }
    const fingerprint = list.fingerprint.replace(/(.{4})/g, "$1 ").trim();
    $("[data-trust-text]").innerHTML = escape(t("c_trust", { signer: list.signer, fingerprint: "\u0000" })).replace("\u0000", `<span class="font-mono text-cream">${fingerprint}</span>`);
    $("[data-signed]").textContent = `${t("c_signed", { signer: list.signer })} · ${list.fingerprint.slice(0, 4)}…${list.fingerprint.slice(-4)}`;
    $("[data-count]").textContent = t("c_count", { version: list.version, n: list.files.length });
    renderList(list);
    $("[data-list-box]").hidden = false;
    root.querySelectorAll("input[name=kind]").forEach((r) => r.addEventListener("change", () => renderList(list)));
    $("input[name=os]").addEventListener("input", () => renderList(list));
  });

  async function hashFile(file: File) {
    print.set("working", t("c_hashing", { name: file.name, pct: 0 }));
    const hasher = sha256.create();
    const reader = file.stream().getReader();
    let done = 0, lastPaint = 0;
    for (;;) {
      const { value, done: end } = await reader.read();
      if (end) break;
      hasher.update(value);
      done += value.length;
      if (performance.now() - lastPaint > 100) {
        const pct = file.size ? Math.floor((done / file.size) * 100) : 100;
        print.set("working", t("c_hashing", { name: file.name, pct }));
        lastPaint = performance.now();
        await new Promise((r) => setTimeout(r));
      }
    }
    const hash = hex(hasher.digest());
    hashInput.value = hash;
    check(hash, file.name);
  }

  fileInput.addEventListener("change", () => { const f = fileInput.files?.[0]; if (f) hashFile(f); });
  drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("over"); });
  drop.addEventListener("dragleave", () => drop.classList.remove("over"));
  drop.addEventListener("drop", (e) => {
    e.preventDefault();
    drop.classList.remove("over");
    const f = e.dataTransfer?.files[0];
    if (f) hashFile(f);
  });
  hashInput.addEventListener("input", () => {
    const value = hashInput.value.trim();
    hashInput.setAttribute("aria-invalid", String(!!value && value.length === 64 && !HASH.test(value)));
    if (HASH.test(value)) check(value);
    else clear();
  });
  bindCopyButtons(root, t("copied"));
</script>
