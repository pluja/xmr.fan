---
import PixelIcon from "../PixelIcon.astro";
import NodeSource from "../live/NodeSource.astro";
import Button from "../ui/Button.astro";
import Printer from "../ui/Printer.astro";
import Receipt from "../ui/Receipt.astro";
import Step from "../ui/Step.astro";
import TrustNote from "../ui/TrustNote.astro";
import { cx, field, label, message } from "../ui/styles";
import { pickStrings, useTranslations, type Locale } from "../../i18n/ui";
import { SAFETY_CHOICES, SAFETY_DAYS } from "../../lib/heights";

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const strings = pickStrings(lang, [
  "h_mined", "h_future", "h_tip", "h_bad_height", "h_n_days", "h_one_day", "h_from", "h_created_at", "h_margin_label", "h_foot_estimate", "h_foot_exact", "h_reverse_wait", "copied",
  "dur_s", "dur_min", "dur_h", "dur_d", "dur_y",
]);
const today = new Date().toISOString().slice(0, 10);
const days = (n: number) => (n === 1 ? t("h_one_day") : t("h_n_days", { n }));
const PICKS = [{ days: 0, name: t("h_today") }, { days: 30, name: t("h_month") }, { days: 365, name: t("h_year") }];
const pick = "cursor-pointer border-2 border-line px-3 py-1.5 font-pixel text-sm text-cream hover:border-orange aria-pressed:border-orange aria-pressed:bg-[#4a2a18] aria-pressed:text-orange";
---
<div id="height-tool" class="grid grid-cols-1 gap-8" data-strings={strings} data-lang={lang}>
  <div class="grid grid-cols-1 items-start gap-x-10 gap-y-8 lg:grid-cols-2">
    <section class="grid gap-3">
      <Step as="label" for="h-date" n="01" label={t("h_created")} />
      <input id="h-date" name="date" type="date" min="2014-04-18" max={today} value={today} class={cx(field, "font-mono text-lg [color-scheme:dark]")} />
      <div class="flex flex-wrap gap-2">
        {PICKS.map((p) => <button type="button" data-pick={p.days} aria-pressed="false" class={pick}>{p.name}</button>)}
        <button type="button" data-unsure aria-expanded="false" aria-controls="h-unsure" class={cx(pick, "border-dashed text-ash")}>{t("h_unsure")}</button>
      </div>
      <p id="h-unsure" class="border-l-4 border-orange bg-ink px-5 py-3 text-sm text-ash" hidden>{t("h_unsure_help")}</p>
    </section>

    <section class="grid gap-3">
      <Step n="02" label={t("h_margin")} />
      <div class="grid grid-cols-3 border-2 border-graphite bg-well p-0.5" role="radiogroup" aria-label={t("h_margin")}>
        {SAFETY_CHOICES.map((n) => (
          <label class="cursor-pointer py-2 text-center font-pixel text-sm text-ash has-checked:bg-orange has-checked:text-ink has-focus-visible:outline-2 has-focus-visible:outline-orange">
            <input type="radio" name="margin" value={n} checked={n === SAFETY_DAYS} class="sr-only" />{days(n)}
          </label>
        ))}
      </div>
      <div class="border-l-4 border-good bg-ink px-5 py-3">
        <p class="text-[15px] text-cream">{t("h_margin_t")}</p>
        <p class="text-sm text-ash">{t("h_margin_sub")}</p>
      </div>
    </section>
  </div>

  <Printer idle={t("h_foot_estimate")} aria-live="polite">
    <Receipt>
      <span class={label}>{t("h_restore")}</span>
        <div class="-mt-2 flex flex-wrap items-center justify-between gap-3">
          <output data-height class="font-pixel text-[clamp(40px,7vw,64px)] leading-none">…</output>
          <span id="restore-height" hidden></span>
          <Button data-copy-from="#restore-height" class="px-4 py-2 text-sm"><PixelIcon name="copy" size={14} /><span>{t("h_copy")}</span></Button>
        </div>
        <p data-from class="-mt-1 text-sm text-graphite"></p>

        <div class="grid gap-2 border-t-2 border-slip-tile pt-4">
          <div class="relative mt-2 flex h-3.5">
            <span data-margin class="bg-[repeating-linear-gradient(45deg,var(--color-orange)_0_2px,var(--color-peach)_2px_4px)]"></span>
            <span class="flex-1 bg-ok"></span>
            <i class="absolute -top-1.5 left-0 h-6.5 w-1 bg-ink"></i>
            <i data-tick class="absolute -top-2 h-7.5 w-1 -translate-x-1/2 bg-ink"></i>
            <i class="absolute -top-1.5 right-0 h-6.5 w-1 bg-ink"></i>
          </div>
          <div class={cx(label, "mt-2 flex flex-wrap gap-x-5 gap-y-1")}>
            <span class="flex items-center gap-1.5"><i class="size-2.5 bg-[repeating-linear-gradient(45deg,var(--color-orange)_0_2px,var(--color-peach)_2px_4px)]"></i><span data-margin-label class="text-flame"></span></span>
            <span class="flex items-center gap-1.5"><i class="size-2.5 bg-ok"></i><span data-created></span></span>
          </div>
          <div class="mt-1 flex justify-between gap-4">
            <div class="grid"><span class={label}>{t("h_start")}</span><span data-start class="font-mono text-sm"></span></div>
            <div class="grid text-right"><span class={label}>{t("h_now")}</span><span data-now class="font-mono text-sm">…</span></div>
          </div>
        </div>

        <Fragment slot="footer">
          <span data-foot class={label}>{t("h_foot_estimate")}</span>
          <span class={cx(label, "ml-auto")}>xmr.fan</span>
        </Fragment>
    </Receipt>
  </Printer>

  <section class="grid grid-cols-1 items-center gap-x-6 gap-y-3 border-l-4 border-orange bg-ink px-5 py-4 md:grid-cols-[minmax(0,1fr)_260px_minmax(0,1fr)]">
    <div>
      <h2 class="font-pixel text-[15px] text-cream">{t("h_block_t")}</h2>
      <p class="text-sm text-ash">{t("h_reverse_sub")}</p>
    </div>
    <div class="grid gap-1">
      <input name="block" inputmode="numeric" placeholder="3000000" autocomplete="off" class={cx(field, "font-mono")} aria-label={t("h_block")} aria-describedby="block-message block-result" />
      <p id="block-message" class={message}></p>
    </div>
    <p id="block-result" data-block-result class="text-sm text-ash" aria-live="polite">{t("h_reverse_wait")}</p>
  </section>

  <div class="grid gap-3 border-t-2 border-graphite pt-5">
    <TrustNote>{t("h_privacy")}</TrustNote>
    <NodeSource lang={lang} dark />
  </div>
</div>

<script>
  import { liveTask } from "../live/live";
  import { bindCopyButtons } from "../ui/copy";
  import { printer } from "../ui/printer";
  import { readStrings } from "../../i18n/format";
  import type { Locale } from "../../i18n/ui";
  import samples from "../../data/heights.json";
  import { heightAt, restoreHeight, timeAt, type Sample } from "../../lib/heights";
  import { getBlockHeader, getInfo } from "../../lib/node-client";
  import { formatDuration } from "../../lib/duration";
  import { BLOCK_SECONDS } from "../../lib/nodes";

  const root = document.getElementById("height-tool")!;
  const t = readStrings(root);
  const lang = root.dataset.lang as Locale;
  const table: Sample[] = samples;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const dateInput = $<HTMLInputElement>("input[name=date]"), blockInput = $<HTMLInputElement>("input[name=block]");
  const num = new Intl.NumberFormat(lang);
  const longDate = new Intl.DateTimeFormat(lang, { dateStyle: "long", timeZone: "UTC" });
  const shortDate = new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeZone: "UTC" });
  const dateTime = new Intl.DateTimeFormat(lang, { dateStyle: "long", timeStyle: "short" });
  const DAY = 86_400;

  let tip: number | undefined;
  const print = printer($("[data-printer]"));
  const margin = () => Number(root.querySelector<HTMLInputElement>("input[name=margin]:checked")!.value);
  const daysText = (n: number) => (n === 1 ? t("h_one_day") : t("h_n_days", { n }));

  /** Walks the estimate to the first block mined at or after `time`, reading timestamps from the node. */
  async function firstBlockAfter(time: number, guess: number): Promise<number> {
    let h = Math.min(guess, tip! - 1);
    for (let i = 0; i < 8; i++) {
      const { timestamp } = await getBlockHeader(h);
      const step = Math.round((time - timestamp) / BLOCK_SECONDS);
      if (step === 0) break;
      h = Math.max(1, Math.min(tip! - 1, h + step));
    }
    return h;
  }

  /** The bar runs from the start of the scan to now; the margin keeps a readable share of it. */
  function paintTimeline(created: number, exact: number, days: number) {
    const start = created - days * DAY, now = Date.now() / 1000;
    const share = Math.min(0.85, Math.max(0.2, (created - start) / Math.max(1, now - start)));
    const pct = `${share * 100}%`;
    $("[data-margin]").style.width = pct;
    $("[data-tick]").style.left = pct;
    $("[data-margin-label]").textContent = t("h_margin_label", { days: daysText(days) });
    $("[data-created]").textContent = t("h_created_at", { height: num.format(exact) });
    $("[data-start]").textContent = shortDate.format(start * 1000);
  }

  function markPicks() {
    const ago = Math.round((Date.parse(new Date().toISOString().slice(0, 10)) - Date.parse(dateInput.value)) / DAY / 1000);
    root.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.pick) === ago)));
  }

  let dateRun = 0;
  async function renderDate() {
    const run = ++dateRun;
    markPicks();
    const time = Date.parse(`${dateInput.value}T00:00:00Z`) / 1000;
    if (!Number.isFinite(time)) return;
    const days = margin();
    const guess = heightAt(time, table);
    const show = (exact: number, checked: boolean) => {
      if (run !== dateRun) return;
      const height = restoreHeight(exact, days);
      $("#restore-height").textContent = String(height);
      $("[data-height]").textContent = num.format(height);
      $("[data-from]").innerHTML = t("h_from", { date: `<b class="font-semibold text-ink">${longDate.format((time - days * DAY) * 1000)}</b>`, days: daysText(days) });
      $("[data-foot]").textContent = t(checked ? "h_foot_exact" : "h_foot_estimate");
      print.set("ok", t(checked ? "h_foot_exact" : "h_foot_estimate"));
      paintTimeline(time, exact, days);
    };
    show(guess, false);
    if (tip) show(await firstBlockAfter(time, guess), true);
  }

  let blockRun = 0;
  async function renderBlock() {
    const run = ++blockRun;
    const out = $("[data-block-result]"), msg = $("#block-message");
    const raw = blockInput.value.trim().replace(/[\s,.]/g, "");
    const valid = /^\d+$/.test(raw);
    blockInput.setAttribute("aria-invalid", String(!!raw && !valid));
    msg.textContent = raw && !valid ? t("h_bad_height") : "";
    out.classList.toggle("text-cream", valid);
    if (!valid) { out.textContent = t("h_reverse_wait"); return; }
    const height = Number(raw);
    const now = Date.now() / 1000;
    if (tip !== undefined && height < tip) {
      out.textContent = t("h_mined", { date: dateTime.format(timeAt(height, table) * 1000) });
      const { timestamp } = await getBlockHeader(height);
      if (run === blockRun) out.textContent = t("h_mined", { date: dateTime.format(timestamp * 1000) });
      return;
    }
    const at = tip !== undefined ? now + (height - tip) * BLOCK_SECONDS : timeAt(height, table);
    out.textContent = at <= now
      ? t("h_mined", { date: dateTime.format(at * 1000) })
      : t("h_future", { date: dateTime.format(at * 1000), when: formatDuration(at - now, t, lang) });
  }

  root.querySelectorAll<HTMLButtonElement>("[data-pick]").forEach((b) => b.addEventListener("click", () => {
    dateInput.value = new Date(Date.now() - Number(b.dataset.pick) * DAY * 1000).toISOString().slice(0, 10);
    renderDate();
  }));
  $("[data-unsure]").addEventListener("click", (e) => {
    const help = $("#h-unsure");
    help.hidden = !help.hidden;
    (e.currentTarget as HTMLElement).setAttribute("aria-expanded", String(!help.hidden));
  });
  dateInput.addEventListener("input", renderDate);
  root.querySelectorAll("input[name=margin]").forEach((r) => r.addEventListener("change", renderDate));
  blockInput.addEventListener("input", renderBlock);
  bindCopyButtons(root, t("copied"));
  renderDate();

  liveTask(async () => {
    tip = (await getInfo()).height;
    $("[data-now]").textContent = num.format(tip);
    await Promise.all([renderDate(), renderBlock()]);
  });
</script>
