---
/* Default slot = the tool; "after" slot = extra sections below it. */
import Base from "../layouts/Base.astro";
import ToolFrame from "./ToolFrame.astro";
import { localePath, useTranslations, type Locale } from "../i18n/ui";
import { breadcrumbLd, toolLd } from "../lib/seo";
import { ogImage, seoDescKey, seoTitleKey, toolPath, titleKey, type Tool } from "../lib/tools";

interface Props { lang: Locale; tool: Tool }
const { lang, tool } = Astro.props;
const t = useTranslations(lang);
const url = (path: string) => new URL(localePath(lang, path), Astro.site).href;
const jsonLd = [
  toolLd(url(toolPath(tool)), t(seoTitleKey(tool)), t(seoDescKey(tool)), lang),
  breadcrumbLd([{ name: "xmr.fan", url: url("/") }, { name: t(titleKey(tool)), url: url(toolPath(tool)) }]),
];
---
<Base lang={lang} path={toolPath(tool)} title={t(seoTitleKey(tool))} description={t(seoDescKey(tool))} image={ogImage(lang, tool.slug)} jsonLd={jsonLd} active="tools" wide={tool.dark}>
  <ToolFrame lang={lang} tool={tool} dark={tool.dark}>
    <slot />
    <slot name="after" slot="after" />
  </ToolFrame>
</Base>
