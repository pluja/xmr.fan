---
import PixelIcon from "./PixelIcon.astro";
import type { IconName } from "../lib/pixel";

interface Props {
  icon: IconName;
  tone?: "orange" | "ink";
  level?: 1 | 2;
  /** e.g. "Esc" */
  kbd?: string;
}
const { icon, tone = "orange", level = 2, kbd } = Astro.props;
const Heading = `h${level}` as "h1" | "h2";
---
<div class:list={["flex items-center gap-3 py-1.5 pl-3.5 pr-2", tone === "orange" ? "bg-orange text-ink" : "bg-ink text-orange"]}>
  <PixelIcon name={icon} size={20} class="shrink-0" />
  <Heading class="font-pixel text-base sm:text-lg"><slot /></Heading>
  {kbd && <kbd class="ml-auto hidden border border-current px-1.5 font-pixel text-xs sm:inline">{kbd}</kbd>}
</div>
